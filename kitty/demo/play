#!/usr/bin/env zsh
# play: the self-running kitty demo, one chapter at a time (see README.md).
#
#   play [CHAPTER [--from N | --only N] [--slow FACTOR] [--dry-run]]
#
# Run it in a kitty pane that is alone in its tab: after the pre-flight
# checks presenterm shows the deck in that pane, and a background director
# plays beats/NN-*.zsh against it. Its log is $TMPDIR/kitty-demo/play.log.
# Abort with Ctrl+Alt+Cmd+. (Hammerspoon) or by quitting presenterm, which
# makes play signal the director.
#
# A chapter with an `instance` file (chapter 3) runs in a kitty instance of
# its own: play builds the chapter's world, starts that kitty on the world's
# session, and the session's deck window runs `play CHAPTER --inside …`.

setopt extended_glob
zmodload zsh/system
DEMO_ROOT=${${(%):-%x}:A:h}
source $DEMO_ROOT/lib.zsh

demo_usage() {
  print -r -- 'usage: play [CHAPTER [--from N | --only N] [--slow FACTOR] [--record FILE] [--dry-run]]'
}

# demo_chapter_dir ARG: the chapter directory for "2" or "2-windows".
demo_chapter_dir() {
  local d
  for d in $DEMO_ROOT/chapters/<->-*(N/n); do
    if [[ ${d:t} == $1 || ${${d:t}%%-*} == $1 ]]; then
      print -r -- $d
      return 0
    fi
  done
  return 1
}

# demo_deck_title DECK: the deck's first slide title (first setext heading);
# the director waits for it to know presenterm is up.
demo_deck_title() {
  awk 'prev != "" && /^=+$/ { print prev; exit } { prev = $0 }' $1
}

# demo_select_beats DIR FROM ONLY: beat files to run, in numeric order.
demo_select_beats() {
  local dir=$1 from=${2:-0} only=$3 f n
  for f in $dir/<->-*.zsh(Nn); do
    n=$(demo_beat_number $f)
    if [[ -n $only ]]; then
      (( n == only )) || continue
    else
      (( n >= from )) || continue
    fi
    print -r -- $f
  done
}

demo_beat_number() { print -r -- $(( 10#${${1:t}%%-*} )) }

# A failing verb returns from the beat (ERR_RETURN), and that ends the run.
demo_source_beat() {
  setopt local_options err_return
  source $1
}

demo_run_beats() {
  local f
  for f in "$@"; do
    DEMO_BEAT=$(demo_beat_number $f)
    print -r -- "# beat $DEMO_BEAT · ${${f:t:r}#*-}"
    demo_source_beat $f || return 1
  done
}

# demo_already_running PIDFILE: true if that pid is a live process.
demo_already_running() {
  local pid
  pid=$(<$1) 2>/dev/null || return 1
  [[ $pid == <-> ]] && kill -0 $pid 2>/dev/null
}

# demo_conf_maps CONF: the map lines of a kitty config and the files it
# includes (relative includes resolve against the including file).
demo_conf_maps() {
  local conf=$1 line inc
  [[ -r $conf ]] || return 0
  while IFS= read -r line; do
    line=${line//$'\t'/ }
    case $line in
      'map '*) print -r -- "$line" ;;
      'include '*)
        inc=${~${line#include }}
        [[ $inc == /* ]] || inc=${conf:h}/$inc
        demo_conf_maps $inc ;;
    esac
  done < $conf
}

# demo_missing_mappings REQUIRES CONF: required actions with no map line.
demo_missing_mappings() {
  local maps req
  maps=$(demo_conf_maps $2)
  while IFS= read -r req; do
    [[ -z $req || $req == '#'* ]] && continue
    grep -qE -- " ${req}( |\$)" <<<$maps || print -r -- $req
  done < $1
}

# Everything a run needs, checked before anything visible happens.
demo_preflight() {
  local ok=1 cmd deck=$KITTY_WINDOW_ID
  [[ -n $deck ]] || { print -u2 'play: run me in a kitty pane'; return 1 }
  if ! demo_kitten ls >/dev/null 2>&1; then
    print -u2 'play: kitten @ cannot reach kitty (allow_remote_control socket-only and listen_on in kitty.conf)'
    return 1
  fi
  if [[ ! -r $DEMO_CHAPTER_DIR/instance ]]; then
    [[ $(demo_kitten ls | jq "[.[].tabs[] | select(any(.windows[]; .id == $deck)) | .windows[]] | length") == 1 ]] \
      || { print -u2 'play: run me in a pane that is alone in its tab'; ok=0 }
  fi
  for cmd in presenterm micro eza rg jq hs; do
    (( $+commands[$cmd] )) || { print -u2 "play: $cmd is not on PATH"; ok=0 }
  done
  if (( $+commands[hs] )); then
    [[ $(demo_hs 'return demoStage ~= nil and hs.accessibilityState()' 2>/dev/null) == true ]] \
      || { print -u2 'play: Hammerspoon has no demoStage, or lacks Accessibility (see README)'; ok=0 }
    demo_stage_current \
      || { print -u2 'play: kitty/demo/stage.lua changed since Hammerspoon loaded it: reload Hammerspoon'; ok=0 }
  fi
  if demo_already_running $DEMO_STATE/play.pid; then
    print -u2 "play: already running (pid $(<$DEMO_STATE/play.pid))"
    ok=0
  fi
  grep -q '^custom_shaders gentle' ~/.config/kitty/kitty.conf 2>/dev/null \
    || print -u2 'play: warning: custom_shaders gentle is not in kitty.conf'
  if [[ -r $DEMO_CHAPTER_DIR/requires ]]; then
    [[ $(demo_hs 'return hs.application.frontmostApplication():bundleID()') == net.kovidgoyal.kitty ]] \
      || { print -u2 'play: kitty must be the frontmost app (this chapter presses real keys)'; ok=0 }
    local missing
    missing=$(demo_missing_mappings $DEMO_CHAPTER_DIR/requires ~/.config/kitty/kitty.conf)
    [[ -z $missing ]] || { print -u2 "play: kitty.conf has no mapping for: ${(j:, :)${(f)missing}}"; ok=0 }
  fi
  (( ok ))
}

# demo_record_preflight FILE: play --record writes a new file, never over one.
demo_record_preflight() {
  [[ ! -e $1 ]] || { print -ru2 -- "play: $1 exists: record to a new file"; return 1 }
  [[ -d ${1:h} ]] || { print -ru2 -- "play: there is no folder ${1:h} to record into"; return 1 }
}

# demo_inside_socket_ok: inside an instance, kitten @ must reach the demo's
# own kitty, never the user's (tidy-windows there would close real windows).
demo_inside_socket_ok() {
  [[ $KITTY_LISTEN_ON == unix:$DEMO_STATE/kitty.sock* ]] \
    || { print -ru2 -- "play: --inside, but kitten @ would reach ${KITTY_LISTEN_ON:-no kitty}, not $DEMO_STATE/kitty.sock"; return 1 }
}

# What an instance chapter needs beyond demo_preflight's checks.
demo_preflight_instance() {
  local ok=1 cmd app
  local claude_dir=${CLAUDE_DEMO_DIR:-$HOME/.claude-demo} world=${DEMO_WORLD:-$HOME/kitty-demo}
  for cmd in kitty zoxide claude code gh uv git; do
    (( $+commands[$cmd] )) || { print -u2 "play: $cmd is not on PATH"; ok=0 }
  done
  [[ -n ${ANTHROPIC_API_KEY:-} ]] || { print -u2 'play: ANTHROPIC_API_KEY is not set (tidy-windows needs it)'; ok=0 }
  [[ -r $claude_dir/kitty-demo-sessions ]] \
    || { print -u2 "play: no Claude demo sessions: log in once with CLAUDE_CONFIG_DIR=$claude_dir claude, then run $DEMO_CHAPTER_DIR/setup-claude"; ok=0 }
  [[ ! -e $world || -e $world/.kitty-demo-world ]] \
    || { print -u2 "play: $world exists and isn't a kitty demo world (set DEMO_WORLD)"; ok=0 }
  for app in com.microsoft.VSCode com.microsoft.edgemac; do
    [[ $(demo_hs "return hs.application.pathForBundleID('$app') ~= nil" 2>/dev/null) == true ]] \
      || { print -u2 "play: $app is not installed"; ok=0 }
  done
  # ide runs `code --reuse-window`, which would take over (and the beat then
  # close) one of the user's own VS Code windows
  [[ $(demo_hs "return hs.application.get('com.microsoft.VSCode') ~= nil" 2>/dev/null) != true ]] \
    || { print -u2 'play: Quit VS Code first: Cmd+I would reuse one of its windows'; ok=0 }
  # project-web reuses an Edge tab already under the repo's URL, and the beat
  # then closes that tab
  demo_edge_urls | grep -q '^https://github.com/garethrowlands/project-tools' \
    && { print -u2 'play: an Edge tab is open on github.com/garethrowlands/project-tools: close it first (Cmd+B would reuse and then close it)'; ok=0 }
  (( ok ))
}

# The URLs of Edge's open tabs, one per line; nothing if Edge isn't running
# (so asking never starts it).
demo_edge_urls() {
  [[ $(demo_hs "return hs.application.get('com.microsoft.edgemac') ~= nil" 2>/dev/null) == true ]] || return 0
  osascript -e 'tell application "Microsoft Edge" to get URL of tabs of windows' 2>/dev/null | tr ',' '\n' | sed 's/^ *//'
}

# demo_instance_cmd WORLD: the command that starts the chapter's kitty, in
# $reply: the user's kitty.conf, the demo's own socket and session, the
# world's environment, and none of the outer kitty's variables.
demo_instance_cmd() {
  reply=(env -u KITTY_WINDOW_ID -u KITTY_LISTEN_ON -u KITTY_PID -u KITTY_PUBLIC_KEY
    ZDOTDIR=$DEMO_STATE/zdotdir PROJECT_ROOTS=$1 PROJECT_CACHE=$DEMO_STATE/projects.txt
    _ZO_DATA_DIR=$DEMO_STATE/zoxide CLAUDE_CONFIG_DIR=${CLAUDE_DEMO_DIR:-$HOME/.claude-demo}
    kitty --listen-on unix:$DEMO_STATE/kitty.sock --start-as=maximized
    -o confirm_os_window_close=0 -o macos_quit_when_last_window_closed=yes
    --session $DEMO_STATE/session.kitty)
}

# demo_run_instance OPTION...: build the world, start its kitty (whose deck
# runs play --inside with the same OPTIONs) and wait for it to quit.
demo_run_instance() {
  local world=${DEMO_WORLD:-$HOME/kitty-demo}
  mkdir -p $DEMO_STATE
  zsh $DEMO_CHAPTER_DIR/build-world $world $DEMO_STATE -- $DEMO_ROOT/play ${DEMO_CHAPTER_DIR:t} --inside "$@" || return 1
  demo_instance_cmd $world
  "${reply[@]}"
}

# demo_present DIRECTOR_PID: show the deck until the viewer quits presenterm,
# then stop the director (its EXIT trap cleans up). Not exec: play runs under
# the pane's shell, which outlives presenterm, so the pane never closes.
demo_present() {
  local director=$1 me=$sysparams[pid]
  # Backstop for a --record take that ran clean: its director sends q to
  # presenterm itself, but if the deck is still up 5 s after the director has
  # gone, end it here, so a chain of takes never waits for someone at the
  # keyboard. (take-ok is only ever written by a clean --record take.)
  (
    while kill -0 $director 2>/dev/null; do sleep 0.5; done
    [[ -e $DEMO_STATE/take-ok ]] || exit 0
    sleep 5
    pkill -TERM -P $me presenterm
  ) >/dev/null 2>&1 </dev/null &!
  presenterm $DEMO_CHAPTER_DIR/deck.md
  kill -TERM $director 2>/dev/null
  return 0
}

# The background half of a real run, from the moment presenterm starts.
demo_direct() {
  demo_begin $DEMO_STATE/play.pid && wait-text deck "$(demo_deck_title $DEMO_CHAPTER_DIR/deck.md)" \
    && demo_record_start && demo_run_beats "$@" && { [[ -z $DEMO_RECORD ]] || { DEMO_QUIT_DECK=1; : >| $DEMO_STATE/take-ok }; return 0 }
  demo_snapshot
  demo_hs "return demoStage.notify($(demo_lua_str "kitty demo stopped at beat ${DEMO_BEAT:-?}: see $DEMO_STATE/play.log"))" >/dev/null 2>&1
  return 1
}

demo_play_main() {
  local from=0 only= inside=0
  local -a passthrough
  local -a beats
  if (( ! $# )); then
    print -r -- 'chapters:'
    local d
    for d in $DEMO_ROOT/chapters/<->-*(N/n); do print -r -- "  ${d:t}"; done
    return 0
  fi
  [[ $1 == (-h|--help) ]] && { demo_usage; return 0 }
  [[ $1 != -* ]] || { demo_usage >&2; return 2 }
  typeset -g DEMO_CHAPTER_DIR
  DEMO_CHAPTER_DIR=$(demo_chapter_dir $1) || { print -u2 "play: no chapter $1"; demo_usage >&2; return 2 }
  shift
  while (( $# )); do
    case $1 in
      --from|--only|--slow)
        (( $# >= 2 )) || { demo_usage >&2; return 2 }
        case $1 in
          --from) from=$2 ;;
          --only) only=$2 ;;
          --slow) DEMO_SLOW=$2 ;;
        esac
        shift 2 ;;
      --record)
        (( $# >= 2 )) || { demo_usage >&2; return 2 }
        DEMO_RECORD=${2:a}; shift 2 ;;
      --dry-run) DEMO_DRY=1; shift ;;
      --inside)  inside=1; shift ;;
      -h|--help) demo_usage; return 0 ;;
      *)         demo_usage >&2; return 2 ;;
    esac
  done
  [[ $from == <-> && ( -z $only || $only == <-> ) && $DEMO_SLOW == [0-9.]## ]] \
    || { demo_usage >&2; return 2 }
  passthrough=()
  (( from )) && passthrough+=(--from $from)
  [[ -n $only ]] && passthrough+=(--only $only)
  [[ $DEMO_SLOW != 1 ]] && passthrough+=(--slow $DEMO_SLOW)
  [[ -n $DEMO_RECORD ]] && passthrough+=(--record $DEMO_RECORD)
  beats=( ${(f)"$(demo_select_beats $DEMO_CHAPTER_DIR/beats $from $only)"} )
  (( $#beats )) || { print -u2 'play: no beats selected'; return 2 }

  if (( DEMO_DRY )); then
    DEMO_IDS[deck]=dry-deck
    demo_run_beats $beats
    return
  fi

  if [[ -n $DEMO_RECORD ]] && (( ! inside )); then
    demo_record_preflight $DEMO_RECORD || return 1
  fi
  if [[ -r $DEMO_CHAPTER_DIR/instance ]] && (( ! inside )); then
    demo_preflight && demo_preflight_instance || return 1
    demo_run_instance $passthrough
    return
  fi
  if (( inside )); then
    demo_inside_socket_ok || return 1
    DEMO_INSIDE=1
  fi
  demo_preflight || return 1
  DEMO_IDS[deck]=$KITTY_WINDOW_ID
  [[ -r $DEMO_CHAPTER_DIR/layout ]] && typeset -g DEMO_START_LAYOUT=$(<$DEMO_CHAPTER_DIR/layout)
  mkdir -p $DEMO_STATE
  : >| $DEMO_STATE/play.log
  rm -f $DEMO_STATE/take-ok
  (
    print -r -- $sysparams[pid] >| $DEMO_STATE/play.pid
    # EXIT traps in zsh functions fire on return, so these live here, in the
    # subshell itself. TERM: presenterm quit, or the abort hotkey.
    trap 'demo_cleanup; rm -f $DEMO_STATE/play.pid' EXIT
    trap 'exit 1' HUP INT TERM
    demo_direct $beats
  ) >>$DEMO_STATE/play.log 2>&1 </dev/null &!
  demo_present $!
}

[[ $ZSH_EVAL_CONTEXT == toplevel ]] && { demo_play_main "$@"; exit }
