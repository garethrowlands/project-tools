# Beat 4: the pointer wanders slowly over the slide's paragraph; the
# spotlight follows. It only scales the brightness of what is there, so the
# pointer stays over text: on empty background it would be invisible.
slide goto 6 'spotlight'
mouse glide-text deck 'Wherever' 900
mouse glide-text deck 'dims a little' 1400
mouse glide-text deck 'empty background' 1200
mouse glide-text deck 'man page' 1400
mouse glide-text deck 'paragraph' 1200
beat-pause 1
