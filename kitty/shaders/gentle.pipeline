# Gentle combination of kitty's shipped custom shaders (kitty >= 0.49).
# Symlinked to ~/.config/kitty/shaders/gentle.pipeline and enabled from
# kitty.conf with:  custom_shaders gentle
# Tunable constants come from the shipped .slang sources:
# https://github.com/kovidgoyal/kitty/tree/master/kitty/shaders/custom
#
# Groups run in order; each one reads the previous group's output.

# 1. Dim inactive windows (same shader/setup as dim-inactive-windows,
#    but much lighter). Static: only redraws when the active window changes.
startgroup
    animation_step 0
    var float HIGHLIGHT_INTENSITY = 0
    var float BORDER_WIDTH = 0
    # fraction of original colour kept in inactive windows (stock: 0.3)
    var float INACTIVE_DIM = 0.85
    # leave the tab bar alone; treat the active window's padding as active
    var bool DIM_CENTRAL_AREA_ONLY = true
    var bool INCLUDE_WINDOW_PADDING = true
    shaders focus-highlight
endgroup

# 2. Brief glow on the newly focused window, and on tab switch (used instead
#    of the tab-change shader, whose animations all reveal from black).
#    INACTIVE_DIM = 1 so this group adds no extra dimming on top of group 1.
startgroup
    animation_start window-focus-in | tab-change
    # stock: 750ms
    animation_stop 500
    animation_curve ease-in
    animation_step 16
    # brightness boost inside the window (stock: 0.30)
    var float HIGHLIGHT_INTENSITY = 0.08
    # stock multiplicative edge glow off (stock: 0.55); the additive glow
    # below shows on dark backgrounds too
    var float BORDER_GLOW = 0
    # additive edge glow (local shader options; stock: off)
    var float GLOW_STRENGTH = 0.5
    # active_border_color #e7e7e7 in linear RGB
    var float3 GLOW_COLOR = float3(0.8)
    var float GLOW_WIDTH_PX = 8.0
    var float INACTIVE_DIM = 1.0
    var bool INCLUDE_WINDOW_PADDING = true
    # local copy of focus-highlight with an additive edge glow
    shaders focus-highlight-local
endgroup

# 3. Spotlight around the mouse pointer: a faint glow brightens the spot and
#    the rest dims a little (the stock spotlight only dims, so over an empty
#    dark background it showed nothing). Hidden while the pointer is hidden
#    (mouse_hide_wait) or outside the window.
startgroup
    animation_start os-window-focus-in | user-activity
    animation_stop os-window-focus-out | user-idle
    # brightness outside the spot (stock: 0.5)
    var float AMBIENT_LIGHT = 0.85
    # spot radius in UV units (stock: 0.25)
    var float SPOTLIGHT_RADIUS = 0.2
    # lower = softer edge (stock: 20); edge width is 1/SOFTNESS, keep it < RADIUS
    var float SPOTLIGHT_SOFTNESS = 10.0
    # additive glow inside the spot, peaking at the centre (local shader
    # options; stock: off). Linear light: strength x colour is the light
    # added, so this is about sRGB #1d1a14 on black at the centre. The colour
    # is a soft warm white (less blue than green than red)
    var float GLOW_STRENGTH = 0.015
    var float3 GLOW_COLOR = float3(0.8, 0.65, 0.45)
    # local copy of spotlight with the additive glow
    shaders spotlight-local
endgroup

# 4. Ripple on left click, smaller and less shiny than stock, with a faint
#    glow on the crests so a click on empty background still shows a ring
#    (the stock ripple only bends and shades pixels that are already there).
startgroup
    animation_start pointer-left-button-press
    # stock: 1500ms
    animation_stop 400
    animation_curve ease-out
    animation_step 16
    # sizes below are in text lines (local shader option; stock measures in
    # window heights): one line in framebuffer pixels, measured (font_size
    # 18 at 1x). Re-measure if the font size or display changes, with
    #   kitten @ kitten $REPO/kitty/demo/demo_geometry.py $TMPDIR/g.json
    #   jq '[.windows[] | (.bottom - .top) / .lines]' $TMPDIR/g.json
    var float LENGTH_UNIT_PX = 23.0
    # max ring radius, lines. The ring fades as it spreads, so what you see
    # is about half this: roughly six lines across
    var float WAVE_SPEED = 6.0
    # ring band half-width, lines
    var float WAVE_WIDTH = 1.5
    # ring spacing, cycles per line
    var float WAVE_FREQUENCY = 0.35
    # text displacement at the crest, lines
    var float AMPLITUDE = 0.12
    # crest slope for the shading; keeps it as gentle as before (stock: 8)
    var float NORMAL_SCALE = 4.0
    # shine / shading (stock: 0.40 / 0.10)
    var float SPECULAR_STRENGTH = 0.06
    var float DIFFUSE_STRENGTH = 0.015
    # additive crest glow (local shader options; stock: off). Linear light, so
    # the crest peaks around sRGB #1d1a14 on black; same warm white as the
    # spotlight; raise the strength for a brighter ring
    var float GLOW_STRENGTH = 0.015
    var float3 GLOW_COLOR = float3(0.8, 0.65, 0.45)
    # local copy of pond-ripple with the additive crest glow
    shaders pond-ripple-local
endgroup

# 5. Cursor trail (needs cursor_trail > 0 in kitty.conf). Last so the trail
#    isn't dimmed or distorted by the groups above. Swap for
#    cursor-trail-lightning or cursor-trail-default to compare.
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    # ~60fps while the trail animates (default 50ms looks laggy)
    animation_step 16
    # speed/length come from cursor_trail_decay in kitty.conf (the local shader
    # follows kitty's own trail animation instead of blaze's DURATION)
    # colours are painted fully opaque, so tone down via the colours (linear RGB)
    # fill, stock: float4(1.0, 0.725, 0.161, 1.0)
    var float4 TRAIL_COLOR = float4(0.8, 0.5, 0.12, 1.0)
    # edge accent uses the cursor colour (local shader option; stock edge is
    # TRAIL_COLOR_ACCENT = float4(1.0, 0.0, 0.0, 1.0))
    var bool ACCENT_FROM_CURSOR = true
    # blend with the text underneath (local shader option; stock: 1.0)
    var float TRAIL_OPACITY = 0.8
    # cap the visible tail at ~15 line heights (local shader option; stock: unlimited)
    var float MAX_TRAIL_LENGTH = 15.0
    # local copy of cursor-trail-blaze that skips trails on window switches
    # (comments must be on their own line: a trailing "# ..." becomes part of
    # the var's value and the pipeline fails to compile)
    shaders cursor-trail-blaze-local
endgroup

# 6-9. OS window focus: a thin amber glow around the whole OS window (all
#    panes and the tab bar) while it has keyboard focus; while it doesn't, a
#    slight dim, cool tint and soft edge shadow (vignette). Last so the
#    dimming, spotlight and ripple above don't dim or distort the glow. The glow adds light, so the pane focus glow
#    (group 2) stays visible where the two overlap.
#    Only os-window-focus-in/out drive these groups, so pane switches and tab
#    changes don't retrigger the pulse. kitty only synthesizes focus-in on
#    pipeline (re)load for OS windows that are actually focused, so unfocused
#    windows start with the unfocused look and without the glow.
#    Shared tuning (pipeline-level vars apply to every group; only
#    os-window-focus-border declares these names):
#    glow colour in linear RGB; the cursor trail's amber
var float3 OSW_FOCUS_COLOR = float3(0.8, 0.5, 0.12)
#    solid border width and inward glow radius, in framebuffer pixels
#    (2 per point on Retina)
var float OSW_FOCUS_BORDER_WIDTH_PX = 1.0
var float OSW_FOCUS_GLOW_RADIUS_PX = 3.0
#    light added at the border, as a fraction of the colour: steady while
#    focused, and at the start of the focus-in pulse
var float OSW_FOCUS_STEADY_INTENSITY = 0.1
var float OSW_FOCUS_PULSE_INTENSITY = 0.6
#    fraction of the original colour kept while unfocused (1 = no dim);
#    linear light, so 0.8 is about 10% darker on screen
var float OSW_UNFOCUSED_DIM = 0.8
#    cool tint while unfocused: colour in linear RGB (sRGB #5a7090) and how
#    much of it to blend in (0 = off; keep well below 1)
var float3 OSW_UNFOCUSED_TINT_COLOR = float3(0.1022, 0.162, 0.2789)
var float OSW_UNFOCUSED_TINT = 0.05
#    edge shadow while unfocused: darkening at the very edge (0 = off; keep
#    below 1), fading out over this many framebuffer pixels from each edge
var float OSW_UNFOCUSED_VIGNETTE = 0.45
var float OSW_UNFOCUSED_VIGNETTE_WIDTH_PX = 120.0

# 6. Unfocused look (dim, tint, vignette) for the whole OS window. Always
#    active and static; group 7 undoes it exactly while focused, so it follows
#    the same focus state as the glow.
startgroup
    animation_step 0
    var int OSW_FOCUS_PASS = 0
    shaders os-window-focus-border
endgroup

# 7. While focused: undo the unfocused look and draw the steady glow. Static
#    (animation_step 0): drawn as part of kitty's normal redraws, never by
#    periodic animation frames. Stops (no time limit) only on
#    os-window-focus-out.
startgroup
    animation_start os-window-focus-in
    animation_stop os-window-focus-out
    animation_step 0
    var int OSW_FOCUS_PASS = 1
    shaders os-window-focus-border
endgroup

# 8. Focus-out fade: eases from the focused look (steady glow, no unfocused
#    look) to the unfocused one instead of switching at once. The number in
#    animation_stop is the fade duration in ms; focus-in cuts it short. Never
#    runs on pipeline load, so unfocused windows still start fully unfocused.
startgroup
    animation_start os-window-focus-out
    animation_stop 400 | os-window-focus-in
    animation_curve ease-out
    animation_step 16
    var int OSW_FOCUS_PASS = 3
    shaders os-window-focus-border
endgroup

# 9. Focus-in pulse on top of the steady glow, settling to it. The number in
#    animation_stop is the pulse duration in ms; animation frames stop with it.
startgroup
    animation_start os-window-focus-in
    animation_stop 450 | os-window-focus-out
    animation_curve ease-in
    animation_step 16
    var int OSW_FOCUS_PASS = 2
    shaders os-window-focus-border
endgroup

# 10. Bell: the edges of the pane that rang flash red-orange and die away
#    (a bell in another tab flashes the whole tab area).
#    Last, so a bell in an unfocused OS window isn't dimmed with it. Needs
#    visual_bell_duration > 0 in kitty.conf for kitty to fire bell-in-window;
#    0.01 keeps kitty's own full-pane flash too short to see. The number in
#    animation_stop is the ring duration in ms; keep the curve linear, the
#    shader shapes the decay itself.
startgroup
    animation_start bell-in-window
    animation_stop 400
    animation_curve linear
    animation_step 16
    # glow colour in linear RGB; muted red-orange (sRGB #f0703c)
    var float3 BELL_COLOR = float3(0.8714, 0.162, 0.0452)
    # blend amount toward the colour at the pane edge at the first strike (0..1;
    # a blend, not added light, so it stays red over the white active border)
    var float BELL_INTENSITY = 0.5
    # how far in from the pane edge the glow fades out, in framebuffer pixels
    var float BELL_WIDTH_PX = 40.0
    # full-strength reach outward past the pane, over kitty's window border
    var float BELL_OUTSET_PX = 4.0
    # number of pulses; 0 = a single flash
    var float BELL_RINGS = 0.0
    shaders bell-ring
endgroup
