# Gentle combination of kitty's shipped custom shaders (kitty >= 0.49).
# Symlinked to ~/.config/kitty/shaders/gentle.pipeline and enabled from
# kitty.conf with:  custom_shaders gentle
# Tunable constants come from the shipped .slang sources:
# https://github.com/kovidgoyal/kitty/tree/master/kitty/shaders/custom
#
# Groups run in order; each one reads the previous group's output.

# 1. Dim inactive windows (same shader/setup as dim-inactive-windows,
#    but much lighter). Static: only redraws when the active window changes.
startgroup
    animation_step 0
    var float HIGHLIGHT_INTENSITY = 0
    var float BORDER_WIDTH = 0
    # fraction of original colour kept in inactive windows (stock: 0.3)
    var float INACTIVE_DIM = 0.85
    # leave the tab bar alone; treat the active window's padding as active
    var bool DIM_CENTRAL_AREA_ONLY = true
    var bool INCLUDE_WINDOW_PADDING = true
    shaders focus-highlight
endgroup

# 2. Brief glow on the newly focused window, and on tab switch (used instead
#    of the tab-change shader, whose animations all reveal from black).
#    INACTIVE_DIM = 1 so this group adds no extra dimming on top of group 1.
startgroup
    animation_start window-focus-in | tab-change
    # stock: 750ms
    animation_stop 500
    animation_curve ease-in
    animation_step 16
    # brightness boost inside the window (stock: 0.30)
    var float HIGHLIGHT_INTENSITY = 0.15
    # border glow strength (stock: 0.55)
    var float BORDER_GLOW = 0.35
    var float INACTIVE_DIM = 1.0
    var bool INCLUDE_WINDOW_PADDING = true
    shaders focus-highlight
endgroup

# 3. Spotlight around the mouse pointer. Hidden while the pointer is hidden
#    (mouse_hide_wait) or outside the window.
startgroup
    animation_start os-window-focus-in | user-activity
    animation_stop os-window-focus-out | user-idle
    # brightness outside the spot (stock: 0.5)
    var float AMBIENT_LIGHT = 0.75
    # spot radius in UV units (stock: 0.25)
    var float SPOTLIGHT_RADIUS = 0.2
    # lower = softer edge (stock: 20); edge width is 1/SOFTNESS, keep it < RADIUS
    var float SPOTLIGHT_SOFTNESS = 10.0
    shaders spotlight
endgroup

# 4. Ripple on left click, smaller and less shiny than stock.
startgroup
    animation_start pointer-left-button-press
    # stock: 1500ms
    animation_stop 700
    animation_curve ease-out
    animation_step 16
    # max ring radius in UV units (stock: 0.45)
    var float WAVE_SPEED = 0.12
    # ring band half-width (stock: 0.055)
    var float WAVE_WIDTH = 0.035
    # text displacement at the crest, UV units (stock: 0.010)
    var float AMPLITUDE = 0.0015
    # shine / shading (stock: 0.40 / 0.10)
    var float SPECULAR_STRENGTH = 0.06
    var float DIFFUSE_STRENGTH = 0.015
    shaders pond-ripple
endgroup

# 5. Cursor trail (needs cursor_trail > 0 in kitty.conf). Last so the trail
#    isn't dimmed or distorted by the groups above. Swap for
#    cursor-trail-lightning or cursor-trail-default to compare.
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    # trail lifetime in seconds (stock: 0.5)
    var float DURATION = 0.35
    # colours are painted fully opaque, so tone down via the colours (linear RGB)
    # fill, stock: float4(1.0, 0.725, 0.161, 1.0)
    var float4 TRAIL_COLOR = float4(0.8, 0.5, 0.12, 1.0)
    # edge accent, stock: float4(1.0, 0.0, 0.0, 1.0)
    var float4 TRAIL_COLOR_ACCENT = float4(0.75, 0.1, 0.05, 1.0)
    shaders cursor-trail-blaze
endgroup
