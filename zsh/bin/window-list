#!/usr/bin/env zsh
# Usage:
#   window-list <closed_entries> <order_file>
#              — generate the fzf window list
#   window-list <closed_entries> <order_file> close <window_id>
#              — close a window and record it in closed_entries

closed_entries=$1
order_file=$2

# Title and agent-state lookups for windows running `claude`
source "${0:A:h}/../functions/claude-session.zsh"

# Builds one fzf row label from a window's tab title, cwd, foreground-process
# basename, and pid — shared by the "close" case and the live-list case below.
# The live list also passes the window's seen_at user var and whether it is
# the window the picker was opened from, to get the state marker; the "close"
# case leaves them out, and its marker blank.
_window_list_label() {
  local tab=$1 cwd=$2 proc=$3 pid=$4 seen_at=$5 is_current=$6
  local base=${cwd:t}
  local state=""
  [[ "$proc" == "claude" && -n "$seen_at" ]] && state=${"$(_claude_session_state "$pid" "$seen_at" "$is_current")"%%$'\t'*}
  local label="$(_claude_session_marker "$state") "
  label+=$([[ -n "$base" ]] && print -r -- "$tab > $base" || print -r -- "$tab")
  local title=""
  [[ "$proc" == "claude" ]] && title=$(_claude_session_title "$pid")
  if [[ -n "$title" ]]; then
    label+=" "$'\033[1;36m'"[$title]"$'\033[0m'
  elif [[ -n "$proc" ]]; then
    label+=" ($proc)"
  fi
  print -r -- "$label"
}

if [[ $3 == close ]]; then
  window_id="${4#closed:}"
  awk -F'\t' -v id="$window_id" '$1==id{exit 1}' "$closed_entries" || exit 0
  local row tab cwd proc pid label
  row=$(kitty @ ls 2>/dev/null | jq -r --argjson wid "$window_id" '
    .[].tabs[] | . as $tab | .windows[] | select(.id == $wid) | . as $w |
    [($tab.title), ($w.foreground_processes[0].cwd // $w.title // ""),
     ($w.foreground_processes[-1].cmdline[0] // "" | ltrimstr("-") | split("/") | last),
     ($w.foreground_processes[-1].pid // "" | tostring)
    ] | join("\t")
  ')
  label=""
  if [[ -n "$row" ]]; then
    IFS=$'\t' read -r tab cwd proc pid <<< "$row"
    label=$(_window_list_label "$tab" "$cwd" "$proc" "$pid")
  fi
  [[ -n "$label" ]] && printf '%s\t%s\n' "$window_id" "$label" >> "$closed_entries"
  kitty @ close-window --match "id:$window_id" 2>/dev/null
  exit 0
fi

# Build the live window list: id<TAB>label, in kitty's natural order.
# seen_at is "-" when the window has none: an empty field would be swallowed
# by read, tab being IFS whitespace.
live_list=$(kitty @ ls 2>/dev/null | jq -r '
  .[].tabs[] | . as $tab | .windows[] | select(.is_self | not) | . as $w |
  [($w.id | tostring), ($tab.title),
   ($w.foreground_processes[0].cwd // $w.title // ""),
   ($w.foreground_processes[-1].cmdline[0] // "" | ltrimstr("-") | split("/") | last),
   ($w.foreground_processes[-1].pid // "" | tostring),
   ($w.user_vars.seen_at // "-")
  ] | join("\t")
' | while IFS=$'\t' read -r id tab cwd proc pid seen_at; do
  printf '%s\t%s\n' "$id" "$(_window_list_label "$tab" "$cwd" "$proc" "$pid" "$seen_at" $(( id == ${WINDOW_CURRENT_ID:-0} )))"
done)

if [[ -s "$order_file" ]]; then
  # Reload after a close: use the saved order so closed entries stay in place
  printf '%s\n' "$live_list" | awk -F'\t' -v of="$order_file" -v cf="$closed_entries" '
  BEGIN {
    while ((getline id < of) > 0) { order[++n] = id; in_order[id] = 1 }
    while ((getline line < cf) > 0) {
      split(line, a, "\t")
      if (a[1] != "") closed_label[a[1]] = a[2]
    }
  }
  { live[$1] = $2 }
  END {
    for (i = 1; i <= n; i++) {
      id = order[i]
      if (id in live)
        print id "\t" live[id]
      else if (id in closed_label)
        print "closed:" id "\t\033[2m[closed] " closed_label[id] "\033[0m"
    }
    for (id in live)
      if (!(id in in_order)) print id "\t" live[id]
  }'
else
  # Initial load: kitty order, merge any pre-existing closed entries
  printf '%s\n' "$live_list" | awk -F'\t' -v cf="$closed_entries" '
  BEGIN {
    while ((getline line < cf) > 0) {
      n = split(line, a, "\t")
      if (n >= 2) closed_label[a[1]] = a[2]
    }
  }
  {
    id = $1
    seen[id] = 1
    if (id in closed_label)
      print "closed:" id "\t\033[2m[closed] " $2 "\033[0m"
    else
      print id "\t" $2
  }
  END {
    for (id in closed_label)
      if (!(id in seen))
        print "closed:" id "\t\033[2m[closed] " closed_label[id] "\033[0m"
  }'
fi
