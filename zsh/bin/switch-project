#!/usr/bin/env zsh

source "${0:A:h}/../functions/project.zsh"

local prev_layout=""
if kitty @ ls &>/dev/null 2>&1; then
  prev_layout=$(kitty @ ls 2>/dev/null \
    | jq -r '.[] | select(.is_focused) | .tabs[] | select(.is_active) | .layout' \
    2>/dev/null | head -1) || true
  [[ -n "$prev_layout" && "$prev_layout" != "stack" ]] && \
    kitty @ goto-layout stack 2>/dev/null || true
fi

local raw_result
raw_result=$(project --new-tab-key)

[[ -n "$prev_layout" && "$prev_layout" != "stack" ]] && \
  kitty @ goto-layout "$prev_layout" 2>/dev/null || true

[[ -z "$raw_result" ]] && exit 0

local project_path="$raw_result" new_tab=0
if [[ "$raw_result" == newtab:* ]]; then
  new_tab=1
  project_path="${raw_result#newtab:}"
fi

local kitty_ls_json
kitty_ls_json=$(kitty @ ls 2>/dev/null) || exit 0
[[ -z "$kitty_ls_json" ]] && exit 0

# Prefer exact CWD match (at project root), fall back to window inside project
local match
match=$(printf '%s' "$kitty_ls_json" | jq -r --arg path "$project_path" '
  .[].tabs[].windows[] |
  select([.foreground_processes[].cwd] | map(. == $path) | any) |
  "window:\(.id)"
' 2>/dev/null | head -1)

if [[ -z "$match" ]]; then
  match=$(printf '%s' "$kitty_ls_json" | jq -r --arg path "$project_path" '
    .[].tabs[].windows[] |
    select([.foreground_processes[].cwd] | map(startswith($path + "/")) | any) |
    "window:\(.id)"
  ' 2>/dev/null | head -1)
fi

if [[ $new_tab -eq 0 ]]; then
  if [[ -n "$match" ]]; then
    kitty @ focus-window --match "id:${match#*:}" 2>/dev/null || true
  else
    kitty @ launch --type=window --cwd "$project_path" 2>/dev/null || true
  fi
  exit 0
fi

# New-tab mode
local tab_name
tab_name=$(basename "$project_path")

_switch_project_find_tab_id() {
  local ls_json="$1" window_id="$2"
  printf '%s' "$ls_json" | jq -r --argjson wid "$window_id" '
    .[].tabs[] | select(any(.windows[]; .id == $wid)) | .id
  ' 2>/dev/null | head -1
}

_switch_project_window_count() {
  local ls_json="$1" tab_id="$2"
  printf '%s' "$ls_json" | jq -r --argjson tid "$tab_id" '
    .[].tabs[] | select(.id == $tid) | .windows | length
  ' 2>/dev/null | head -1
}

if [[ -n "$match" ]]; then
  local window_id="${match#*:}"
  local tab_id window_count
  tab_id=$(_switch_project_find_tab_id "$kitty_ls_json" "$window_id")
  window_count=$(_switch_project_window_count "$kitty_ls_json" "$tab_id")

  if [[ "$window_count" -eq 1 ]]; then
    kitty @ set-tab-title --match "id:${tab_id}" "$tab_name" 2>/dev/null || true
    kitty @ focus-window --match "id:${window_id}" 2>/dev/null || true
  else
    kitty @ detach-window --match "id:${window_id}" --target-tab new 2>/dev/null || true
    local new_ls new_tab_id
    new_ls=$(kitty @ ls 2>/dev/null) || true
    new_tab_id=$(_switch_project_find_tab_id "$new_ls" "$window_id")
    [[ -n "$new_tab_id" ]] && kitty @ set-tab-title --match "id:${new_tab_id}" "$tab_name" 2>/dev/null || true
    kitty @ focus-window --match "id:${window_id}" 2>/dev/null || true
  fi
else
  local new_window_id
  new_window_id=$(kitty @ launch --type=tab --cwd "$project_path" 2>/dev/null) || true
  if [[ -n "$new_window_id" ]]; then
    local new_ls new_tab_id
    new_ls=$(kitty @ ls 2>/dev/null) || true
    new_tab_id=$(_switch_project_find_tab_id "$new_ls" "$new_window_id")
    [[ -n "$new_tab_id" ]] && kitty @ set-tab-title --match "id:${new_tab_id}" "$tab_name" 2>/dev/null || true
  fi
fi
