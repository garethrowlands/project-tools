#!/usr/bin/env zsh

source "${0:A:h}/../functions/project.zsh"

kitten @ goto-layout stack 2>/dev/null || true

local raw_result
raw_result=$(project --new-tab-key "$@")

kitten @ last-used-layout 2>/dev/null || true

[[ -z "$raw_result" ]] && exit 0

local project_path="$raw_result" new_tab=0
if [[ "$raw_result" == newtab:* ]]; then
  new_tab=1
  project_path="${raw_result#newtab:}"
fi

local kitty_ls_json
kitty_ls_json=$(kitty @ ls 2>/dev/null) || exit 0
[[ -z "$kitty_ls_json" ]] && exit 0

# Prefer exact CWD match (at project root), fall back to window inside project
local match
match=$(printf '%s' "$kitty_ls_json" | jq -r --arg path "$project_path" '
  .[].tabs[].windows[] |
  select([.foreground_processes[].cwd] | map(. == $path) | any) |
  "window:\(.id)"
' 2>/dev/null | head -1)

if [[ -z "$match" ]]; then
  match=$(printf '%s' "$kitty_ls_json" | jq -r --arg path "$project_path" '
    .[].tabs[].windows[] |
    select([.foreground_processes[].cwd] | map(startswith($path + "/")) | any) |
    "window:\(.id)"
  ' 2>/dev/null | head -1)
fi

if [[ $new_tab -eq 0 ]]; then
  if [[ -n "$match" ]]; then
    kitty @ focus-window --match "id:${match#*:}" 2>/dev/null || true
  else
    kitty @ launch --type=window --cwd "$project_path" 2>/dev/null || true
  fi
  exit 0
fi

# New-tab mode: the project's own tab (see _project_open_in_tab)
_project_open_in_tab "$project_path" "${match#*:}"
