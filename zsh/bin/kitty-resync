#!/usr/bin/env zsh
# Reload kitty's config so it re-sends focus-in to the OS window that has focus.
#
# After the Mac sleeps, kitty's OS-window focus shader (kitty/shaders/
# gentle.pipeline, groups 6-7) can be left showing the unfocused vignette on a
# focused window: the shader follows os-window-focus-in/out events, and a
# reload makes kitty synthesize focus-in for focused windows. Hammerspoon runs
# this after wake (hammerspoon/init.lua); it has no PATH and no
# KITTY_LISTEN_ON, so both are found here. Logs to the same file as
# kitty/focus_watcher.py's focus events, so the two can be lined up.

export PATH=/Applications/kitty.app/Contents/MacOS:$PATH
log=${XDG_CACHE_HOME:-$HOME/.cache}/project-tools/kitty-focus.log
mkdir -p $log:h

if [[ -z $KITTY_LISTEN_ON ]]; then
  for sock in $HOME/.config/kitty/kitty-*.sock(N); do
    pid=${${sock:t:r}#kitty-}
    kill -0 $pid 2>/dev/null || continue
    export KITTY_LISTEN_ON=unix:$sock KITTY_PID=$pid
    break
  done
fi

if [[ -z $KITTY_LISTEN_ON ]]; then
  print "$(date '+%F %T') resync: no running kitty socket" >> $log
  exit 0
fi
if kitten @ load-config 2>/dev/null; then
  print "$(date '+%F %T') resync: reloaded config" >> $log
else
  print "$(date '+%F %T') resync: kitten @ load-config failed" >> $log
fi
