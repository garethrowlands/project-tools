#!/usr/bin/env zsh

_ide_detect() {
  local path="$1"
  if [[ -f "$path/pom.xml" || -f "$path/build.gradle" || -f "$path/build.gradle.kts" || -d "$path/.idea" ]]; then
    echo "idea"
  else
    echo "code"
  fi
}

local project
project=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || { echo "not a git project"; exit 1 }
[[ -z "$project" ]] && { echo "not a git project"; exit 1 }

local ide_cmd
ide_cmd=$(_ide_detect "$project")

local basename="${project:t}"

_close_app_windows() {
  local process_name="$1" match="$2"
  osascript 2>/dev/null <<APPLESCRIPT || true
tell application "System Events"
  if exists process "$process_name" then
    repeat with w in (every window of process "$process_name")
      if name of w contains "$match" then
        perform action "AXClose" of w
      end if
    end repeat
  end if
end tell
APPLESCRIPT
}

case "$ide_cmd" in
  code) _close_app_windows "Code" "$basename" ;;
  idea) _close_app_windows "IntelliJ IDEA" "$basename" ;;
esac

kitty @ close-window --match "id:$KITTY_WINDOW_ID" 2>/dev/null || true
