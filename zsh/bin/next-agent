#!/usr/bin/env zsh
# Focuses a kitty window running a Claude Code agent that needs you, if any
# does: blocked on a prompt or question first, then failed, then finished
# unseen, the most recent first within each. Pressing it again moves on to the
# next of those, so repeated presses cycle through them all. When none needs
# you (or only the window you're in does) it goes to the claude window you
# were last in, so the key toggles between two agents. `--prev` goes the other
# way round (the least recently focused, when nothing needs you). Bound in
# kitty.conf as
#
#   map kitty_mod+j       launch --type=overlay --cwd=current next-agent
#   map kitty_mod+shift+j launch --type=overlay --cwd=current next-agent --prev
#
# like the pickers: as an overlay it has kitty's socket (KITTY_LISTEN_ON, which
# a --type=background launch doesn't get). Needs kitty/focus_watcher.py for the
# states and their timestamps (kitty >= 0.50, Claude Code >= 2.1.295).

local step=1
[[ $1 == --prev ]] && step=-1

local kitty_ls
kitty_ls=$(kitty @ ls 2>/dev/null) || { echo "kitty not available" >&2; exit 1 }

# The window you are in: the one this overlay covers, as in zsh/bin/window.
# Run from a shell instead there is no overlay, and it's the active window of
# the active tab of the focused OS window (`is_focused` alone is true for the
# active window of every tab).
local current_id
current_id=$(kitty @ ls --match 'state:overlay_parent' 2>/dev/null | jq -r '.[].tabs[].windows[].id' | head -1)
[[ -z "$current_id" ]] && current_id=$(printf '%s' "$kitty_ls" | jq -r '
  .[] | select(.is_focused) | .tabs[] | select(.is_active) | .windows[] | select(.is_active) | .id
' | head -1)

# One `RANK STATE_AT ID` line per window with an agent state, in kitty's order:
# blocked (0), error (1), done (2). The states come from the `agent_state` and
# `agent_state_at` user vars that kitty/focus_watcher.py publishes from the
# window's Program Status Protocol records. A window with no state isn't ranked.
local agents
agents=$(printf '%s' "$kitty_ls" | jq -r '
  .[].tabs[].windows[] | select(.is_self | not) |
  [(.user_vars.agent_state // "-"), .id, (.user_vars.agent_state_at // "0")] | join(" ")
' | while read -r state id at; do
  case $state in
    blocked) print -r -- "0 $at $id" ;;
    error)   print -r -- "1 $at $id" ;;
    'done')  print -r -- "2 $at $id" ;;
  esac
done)

# The ones needing you: by rank, then the most recent change first
local -a waiting all
waiting=(${(f)"$(printf '%s\n' "$agents" | sort -k1,1n -k2,2nr -k3,3n | awk 'NF {print $3}')"})

# Every claude window (or one with an agent state) but the current one, the
# most recently focused first — what's left when nothing needs you. Stepping
# from outside a list lands on its first, or with --prev its last.
all=(${(f)"$(printf '%s' "$kitty_ls" | jq -r '
  .[].tabs[].windows[] | select(.is_self | not) |
  select(((.foreground_processes[-1].cmdline[0] // "" | ltrimstr("-") | split("/") | last) == "claude")
         or (.user_vars.agent_state // "") != "") |
  [.last_focused_at, .id] | @tsv
' | sort -k1,1nr -k2,2n | cut -f2)"})
all=(${all:#$current_id})

# Prints the window one step on from the current one in the given list,
# wrapping round; from outside the list, its first (or, backwards, its last)
_next_agent_pick() {
  local -a ids=("$@")
  (( $#ids )) || return
  local i=${ids[(Ie)$current_id]}
  if (( i == 0 )); then
    (( step > 0 )) && print -r -- $ids[1] || print -r -- $ids[-1]
  else
    print -r -- $ids[$(( (i - 1 + step + $#ids) % $#ids + 1 ))]
  fi
}

local target
target=$(_next_agent_pick $waiting)
[[ -z "$target" || "$target" == "$current_id" ]] && target=$(_next_agent_pick $all)
# no other agent window to go to
[[ -z "$target" || "$target" == "$current_id" ]] && exit 0
kitty @ focus-window --match "id:${target}" 2>/dev/null
