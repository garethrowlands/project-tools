#!/usr/bin/env zsh

_ide_git_root() {
  local dir="$1"
  [[ -f "$dir" ]] && dir="${dir:h}"
  git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "$dir"
}

_ide_detect() {
  local path="$1"
  if [[ -f "$path/pom.xml" || -f "$path/build.gradle" || -f "$path/build.gradle.kts" || -f "$path/go.mod" || -d "$path/.idea" ]]; then
    echo "idea"
  elif [[ -d "$path/.vscode" ]]; then
    echo "code"
  else
    echo "code"
  fi
}

# Make sure PATH has an nvm-managed node/pnpm satisfying package.json's
# engines.node before launching the IDE. Needed because this script doesn't
# source ~/.zshrc (where `nvm use default` normally runs), so depending on
# how it's invoked, PATH may have no nvm node on it at all.
_ide_use_node() {
  local dir="$1"
  [[ -f "$dir/package.json" ]] || return 0

  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  [[ -s "$NVM_DIR/nvm.sh" ]] || return 0
  source "$NVM_DIR/nvm.sh" --no-use

  if [[ -f "$dir/.nvmrc" ]]; then
    (cd "$dir" && nvm use --silent) 2>/dev/null
    return 0
  fi

  # Crude extract of a minimum major version from "engines": { "node": ">=24.0.0" }
  local required
  required=$(grep -A2 '"engines"' "$dir/package.json" 2>/dev/null | grep '"node"' | grep -oE '[0-9]+' | head -1)

  if [[ -n "$required" ]]; then
    nvm use "$required" --silent 2>/dev/null || nvm use default --silent 2>/dev/null
  else
    nvm use default --silent 2>/dev/null
  fi
}

# `ide path[:line[:column]]`. A path that exists, colons and all, is a path.
local target=${1:-$PWD} line column
setopt extended_glob
if [[ ! -e $target ]] && [[ $target == (#b)(*):(<->):(<->) || $target == (#b)(*):(<->) ]]; then
  target=$match[1] line=$match[2] column=$match[3]
  if [[ -d $target ]]; then
    print -u2 "ide: $target is a directory, so it can't take a line number"
    exit 1
  elif [[ ! -f $target ]]; then
    print -u2 "ide: no such file: $target"
    exit 1
  fi
  # through a symlink IntelliJ wouldn't see the file as inside the open project
  target=${target:A}
fi

local project
project=$(_ide_git_root "$target")

_ide_use_node "$project"

local ide_cmd
ide_cmd=$(_ide_detect "$project")
[[ -z "$ide_cmd" ]] && exit 0

# Percent-encodes everything but unreserved characters, for idea:// URLs.
_ide_urlencode() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

case "$ide_cmd" in
  code)
    if [[ -n $line ]]; then
      code --reuse-window --goto "$target:$line${column:+:$column}" "$project"
    else
      code --reuse-window "$project"
    fi ;;
  # Not the Toolbox `idea` shim: it runs `open -n`, spawning a whole extra
  # IntelliJ process per call instead of reusing/focusing the running one.
  idea)
    open -a "IntelliJ IDEA" "$project"
    if [[ -n $line ]]; then
      # IntelliJ opens a file in its project only if that project is already
      # open (otherwise in a bare LightEdit window), so wait for the first
      # step; the running instance then handles the idea:// URL.
      sleep ${IDE_JUMP_DELAY:-1}
      open "idea://open?file=$(_ide_urlencode "$target")&line=$line${column:+&column=$column}"
    fi ;;
esac
