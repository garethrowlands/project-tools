#!/usr/bin/env zsh

_ide_git_root() {
  local dir="$1"
  [[ -f "$dir" ]] && dir="${dir:h}"
  git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "$dir"
}

_ide_detect() {
  local path="$1"
  if [[ -f "$path/pom.xml" || -f "$path/build.gradle" || -f "$path/build.gradle.kts" || -d "$path/.idea" ]]; then
    echo "idea"
  elif [[ -d "$path/.vscode" ]]; then
    echo "code"
  else
    echo "code"
  fi
}


local project
project=$(_ide_git_root "${1:-$PWD}")

local ide_cmd
ide_cmd=$(_ide_detect "$project")
[[ -z "$ide_cmd" ]] && exit 0

case "$ide_cmd" in
  code) code --reuse-window "$project" ;;
  idea) idea "$project" ;;
esac
