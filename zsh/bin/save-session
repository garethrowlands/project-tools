#!/usr/bin/env zsh
# Saves every open kitty window as a session file, so that a restart of kitty
# (or of the machine) can bring them all back: tabs, layouts, working
# directories, and each Claude Code agent resumed in its own window.
#
#   save-session [FILE]     default ~/.config/kitty/sessions/restore.kitty-session
#
# To restore, point kitty.conf at the file:
#
#   startup_session ~/.config/kitty/sessions/restore.kitty-session
#
# kitty writes the file itself (its `save_as_session` action), which knows
# nothing of Claude: a window running `claude` would come back as a bare shell.
# kitty does record each window's id in its `launch` line, though, as
#
#   launch 'kitty-unserialize-data={"id": 12}' --cwd=...
#
# and that same JSON may carry "cmd_at_shell_startup", a command the restored
# window's shell runs on starting (through kitty's shell integration) — it is
# how kitty's own --use-foreground-process restores a running program. So for
# each window running `claude` (in the foreground, or suspended), this adds
# `claude --resume <session id>` there (`claudek` for a ~/.claude-k session);
# the id comes from the process's sessions/<pid>.json — see zsh/functions/claude-session.zsh. That option isn't
# used itself: it would re-run whatever any window happened to be running.
#
# Any other window that was in the middle of a command (`pnpm dev`, say) comes
# back with that command typed at its prompt, not run: the same mechanism, with
# `print -z`, which puts text in the shell's editing buffer. A pager (`less
# FILE`, `man zsh`) is run, since that is safe. Either way it is the command
# line as it was typed, which kitty's shell integration reports
# (`last_reported_cmdline`), so aliases and arguments are as they were.
#
# Needs kitty's socket (KITTY_LISTEN_ON), so run it from a shell in kitty or as
# an overlay.

source "${0:A:h}/../functions/claude-session.zsh"

local out=${1:-$HOME/.config/kitty/sessions/restore.kitty-session}
local tmp
tmp=$(mktemp -d)
trap 'rm -rf $tmp' EXIT

local kitty_ls
kitty_ls=$(kitty @ ls 2>/dev/null) || { echo "kitty not available" >&2; exit 1 }
kitty @ action save_as_session --save-only $tmp/saved
[[ -s $tmp/saved ]] || { echo "kitty saved no session" >&2; exit 1 }

# `PPID PID` of every running claude, to find one that isn't in the foreground:
# suspended with Ctrl+Z it is a stopped job of the window's shell, and kitty
# lists only the shell.
local claude_children
claude_children=$(ps -axo ppid=,pid=,args= 2>/dev/null | awk '{ n = split($3, p, "/"); sub(/^-/, "", p[n]); if (p[n] == "claude") print $1, $2 }')

# One `ID<TAB>JSON` line per window running claude: the JSON that replaces its
# `{"id": ID}`. A session is only found again under its own config dir, and a
# second profile needs more than CLAUDE_CONFIG_DIR (its own endpoint and
# token), so the command is the one named after the config dir: `claude` for
# ~/.claude, `claudek` for ~/.claude-k — an alias the restored shell expands.
printf '%s' "$kitty_ls" | jq -r '
  .[].tabs[].windows[] |
  ((.foreground_processes[-1].cmdline[0] // "" | ltrimstr("-") | split("/") | last) == "claude") as $fg |
  "\(.id) \(if $fg then .foreground_processes[-1].pid else "-" end) \(.pid // 0)"
' | while read -r id pid shell_pid; do
  local session_file session_id cmd
  [[ $pid == - ]] && pid=$(print -r -- "$claude_children" | awk -v p=$shell_pid '$1 == p { print $2; exit }')
  session_file=$(_claude_session_file "$pid")
  [[ -z "$session_file" ]] && continue
  session_id=$(jq -r '.sessionId // empty' "$session_file" 2>/dev/null)
  # the command is run by a shell, and sits inside a single-quoted word
  [[ "$session_id" =~ '^[A-Za-z0-9-]+$' ]] || continue
  cmd=${${session_file:h:h:t}#.}
  cmd=${cmd//-/}
  [[ "$cmd" =~ '^[A-Za-z0-9_]+$' ]] || continue
  # kitty's shell integration evals this with aliases off; the inner eval is
  # parsed once they are back on. It runs in the shell's first precmd, when a
  # prompt with an instant mode (Powerlevel10k's) still has the shell's output
  # going to a file: claude would take itself for a script and refuse to
  # resume without a prompt, so it is given the terminal by name: the shell's
  # $TTY, not /dev/tty, which macOS's kqueue refuses and claude dies of
  # ("EINVAL: invalid argument, kqueue"). kitty leaves the $ alone: this JSON
  # is taken off the launch line before variables in it are expanded.
  cmd="setopt aliases; eval \"$cmd --resume $session_id <\$TTY >\$TTY 2>&1\""
  jq -rn --argjson id "$id" --arg cmd "$cmd" '"\($id)\t" + ({id: $id, cmd_at_shell_startup: $cmd} | tojson)'
done >| $tmp/resume

# The same for every other window that was running a command when saved (not
# at a prompt), bar the one this was run from: its command line, typed — or
# run, when it is a pager and nothing but (no pipe, substitution or second
# command). $q is a single quote, which this jq program cannot hold: the
# command line is quoted for the shell with them, and those are then written
# as JSON escapes, since the JSON sits in a single-quoted word of the session.
printf '%s' "$kitty_ls" | jq -r --arg self "${KITTY_WINDOW_ID:-0}" --arg q "'" --rawfile resumed $tmp/resume '
  def sq: $q + gsub($q; $q + "\\" + $q + $q) + $q;
  ($resumed | split("\n") | map(split("\t")[0])) as $done |
  .[].tabs[].windows[] |
  (.last_reported_cmdline // "") as $typed |
  select(.at_prompt == false and $typed != "") |
  select((.id | tostring) as $id | $id != $self and ($done | index($id) | not)) |
  (if ($typed | test("^(less|more|most|bat|man)( |$)")) and ($typed | test("[|;&<>`$()\n]") | not)
   then "setopt aliases; eval " + ($typed | sq) + " " + ("<$TTY >$TTY 2>&1" | sq)
   else "print -z -- " + ($typed | sq) end) as $cmd |
  "\(.id)\t" + ({id, cmd_at_shell_startup: $cmd} | tojson | gsub($q; "\\u0027"))
' >| $tmp/typed

# Dropped on the way: the overlay this runs in when launched from a key
# binding (it would run save-session again on every start), and the user vars
# kitty/focus_watcher.py keeps — they describe the windows as they were.
awk -v map=$tmp/resume -v typed_map=$tmp/typed -v self="${KITTY_WINDOW_ID:-0}" '
  BEGIN {
    while ((getline line < map) > 0) { tab = index(line, "\t"); resume[substr(line, 1, tab - 1)] = substr(line, tab + 1) }
    while ((getline line < typed_map) > 0) { tab = index(line, "\t"); typed[substr(line, 1, tab - 1)] = substr(line, tab + 1) }
  }
  /^launch / && match($0, /kitty-unserialize-data=\{"id": [0-9]+\}/) {
    id = substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", id)
    if (id == self && index($0, " --type=overlay")) next
    if (id in resume) { $0 = substr($0, 1, RSTART - 1) "kitty-unserialize-data=" resume[id] substr($0, RSTART + RLENGTH); resumed++ }
    else if (id in typed) { $0 = substr($0, 1, RSTART - 1) "kitty-unserialize-data=" typed[id] substr($0, RSTART + RLENGTH); commands++ }
    gsub(/ --var=(agent_state|seen_at)=[^ ]*/, "")
    windows++
  }
  { print }
  END { printf "%d windows, %d Claude sessions, %d other commands\n", windows, resumed, commands > "/dev/stderr" }
' $tmp/saved >| $tmp/out 2>| $tmp/summary

mkdir -p ${out:h} && mv $tmp/out $out || exit 1
print -r -- "saved $(<$tmp/summary) to $out"
