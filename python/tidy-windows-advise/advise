#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["anthropic>=0.40"]
# ///
"""Review open kitty windows and recommend close / move / keep.

Reads `kitty @ ls` JSON (via --kitty-ls or stdin) and prints a TSV table
(`id  action  target_tab  display`) for the caller (zsh/bin/tidy-windows) to feed
into fzf and act on. --dry-run prints a human-readable table instead.

Close-vs-keep is judged by the Claude API (idle time, git state). Move
recommendations (consolidating a project's windows onto one tab) are computed
deterministically in Python — no AI call needed for that part.
"""

import argparse
import json
import subprocess
import sys
import time
from collections import Counter
from pathlib import Path

import anthropic

DEFAULT_MODEL = "claude-haiku-4-5-20251001"
NO_RECOMMENDATION = "(no recommendation available)"

# ── kitty ls parsing ─────────────────────────────────────────────────────────


def _cmdline_basename(cmdline: list | None) -> str:
    """The frontmost command's basename, e.g. "-/opt/homebrew/bin/claude" -> "claude"."""
    if not cmdline:
        return ""
    first = cmdline[0] or ""
    if first.startswith("-"):
        first = first[1:]
    return Path(first).name


def build_rows(kitty_ls_json: list) -> list[dict]:
    """Flatten `kitty @ ls` JSON into one row per real (non-self) window with a cwd."""
    rows = []
    for os_window in kitty_ls_json:
        for tab in os_window.get("tabs", []):
            for window in tab.get("windows", []):
                if window.get("is_self"):
                    continue
                fg = window.get("foreground_processes") or [{}]
                cwd = fg[0].get("cwd")
                if not cwd:
                    continue
                rows.append(
                    {
                        "id": window["id"],
                        "tab_id": tab.get("id"),
                        "tab_title": tab.get("title", ""),
                        "title": window.get("title", ""),
                        "cwd": cwd,
                        "cmdline": fg[0].get("cmdline", []),
                        "is_focused": bool(window.get("is_focused")),
                        "last_focused_at": window.get("last_focused_at"),
                        # last foreground process is the front-most running command
                        # (e.g. `claude`) - used to look up a Claude session name below.
                        "pid": fg[-1].get("pid"),
                        "proc": _cmdline_basename(fg[-1].get("cmdline")),
                    }
                )
    return rows


# ── Claude session titles ────────────────────────────────────────────────────
#
# See zsh/bin/window-list's _window_list_claude_title for the full rationale (this
# mirrors it): <config-dir>/sessions/<pid>.json's "name" field is NOT the conversation
# title shown in Claude Code's own UI/history - it's a short slug derived at startup,
# used as an addressable session name elsewhere. The actual human-facing title is
# recorded as a `{"type":"ai-title","aiTitle":"..."}` line appended to that session's
# own transcript, at <config-dir>/projects/*/<sessionId>.jsonl - found by sessionId
# rather than by reconstructing the project-slug directory name from cwd, since that
# slug transform is lossy (e.g. "." becomes "-" too, not just "/"). An interactive
# session can also "park" on a background job (a separate claude process, with its own
# pid/session file, "kind":"bg") via "parkedJobId" matching the job's own "jobId"; while
# parked, the interactive session's own transcript typically has no ai-title yet, so the
# lookup follows parkedJobId to the job's session file and resolves its title the same
# way. And a `claude` process may run under a non-default config dir (e.g.
# CLAUDE_CONFIG_DIR=~/.claude-k for a separate work profile), so every ~/.claude*
# directory with a sessions/ subfolder is searched, not just ~/.claude.
#
# All of this is undocumented internal state, so failures here should never be fatal.


def _config_dirs(home: Path | None = None) -> list[Path]:
    home = home or Path.home()
    return sorted(p for p in home.glob(".claude*") if (p / "sessions").is_dir())


def _read_json(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def _find_transcript(config_dir: Path, session_id: str) -> Path | None:
    matches = list((config_dir / "projects").glob(f"*/{session_id}.jsonl"))
    return matches[0] if matches else None


def _last_ai_title(transcript: Path) -> str | None:
    title = None
    try:
        with transcript.open(encoding="utf-8") as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if entry.get("type") == "ai-title" and isinstance(entry.get("aiTitle"), str) and entry["aiTitle"]:
                    title = entry["aiTitle"]
    except OSError:
        return None
    return title


def _title_from_session_file(config_dir: Path, session_file: Path) -> str | None:
    """The best available title recorded in one sessions/<pid>.json: its own ai-title,
    else (if parked on a background job) that job's title by the same rule, else its
    own "name" slug."""
    data = _read_json(session_file)
    if data is None:
        return None
    session_id = data.get("sessionId")
    if isinstance(session_id, str) and session_id:
        transcript = _find_transcript(config_dir, session_id)
        if transcript is not None:
            title = _last_ai_title(transcript)
            if title:
                return title
    parked_job_id = data.get("parkedJobId")
    if isinstance(parked_job_id, str) and parked_job_id:
        for job_file in (config_dir / "sessions").glob("*.json"):
            if job_file == session_file:
                continue
            job_data = _read_json(job_file)
            if job_data and job_data.get("jobId") == parked_job_id:
                job_title = _title_from_session_file(config_dir, job_file)
                if job_title:
                    return job_title
                break
    name = data.get("name")
    return name if isinstance(name, str) and name else None


def claude_session_name(pid, config_dirs: list[Path] | None = None) -> str | None:
    """Look up a running Claude Code session's title by its pid."""
    if not pid:
        return None
    for config_dir in config_dirs if config_dirs is not None else _config_dirs():
        session_file = config_dir / "sessions" / f"{pid}.json"
        if session_file.is_file():
            return _title_from_session_file(config_dir, session_file)
    return None


# ── idle time ────────────────────────────────────────────────────────────────


def parse_boottime(sysctl_output: str) -> float:
    """Parse `sysctl -n kern.boottime` output (`{ sec = 123, usec = 456 }`) to epoch seconds."""
    sec = 0.0
    usec = 0.0
    for part in sysctl_output.replace("{", "").replace("}", "").split(","):
        part = part.strip()
        if part.startswith("sec"):
            sec = float(part.split("=")[1].strip())
        elif part.startswith("usec"):
            usec = float(part.split("=")[1].strip())
    return sec + usec / 1_000_000


def boot_epoch() -> float | None:
    """Best-effort; returns None if `sysctl` is unavailable/unsupported (e.g. non-macOS, sandboxed)."""
    try:
        output = subprocess.run(
            ["sysctl", "-n", "kern.boottime"], capture_output=True, text=True, check=True
        ).stdout
        return parse_boottime(output)
    except (subprocess.CalledProcessError, FileNotFoundError, ValueError):
        return None


def idle_label(last_focused_at, is_focused: bool, boot_epoch_s: float | None, now_epoch_s: float) -> str:
    if is_focused:
        # NOT "the window the user is using right now" - kitty's is_focused is per-tab (the
        # last-active window *within that tab*), so several unrelated windows can show this
        # simultaneously. Worded to avoid being mistaken for protect_current_window's
        # unambiguous "YOU ARE HERE" marker, which is the real current-window signal.
        return "active in tab"
    if last_focused_at is None or boot_epoch_s is None:
        return "idle"
    idle_seconds = now_epoch_s - (boot_epoch_s + float(last_focused_at))
    idle_seconds = max(idle_seconds, 0)
    minutes = idle_seconds / 60
    if minutes < 60:
        return f"{max(1, round(minutes))}m idle"
    hours = minutes / 60
    if hours < 24:
        return f"{round(hours)}h idle"
    days = hours / 24
    return f"{round(days)}d idle"


# ── git enrichment ───────────────────────────────────────────────────────────


def _git(cwd: str, *args: str) -> str | None:
    result = subprocess.run(
        ["git", "-C", cwd, *args], capture_output=True, text=True
    )
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def git_summary(cwd: str) -> dict | None:
    root = _git(cwd, "rev-parse", "--show-toplevel")
    if root is None:
        return None
    branch = _git(cwd, "branch", "--show-current") or "(detached)"
    status = _git(cwd, "status", "--porcelain") or ""
    dirty = bool(status.strip())
    ahead = 0
    behind = 0
    counts = _git(cwd, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
    if counts:
        parts = counts.split()
        if len(parts) == 2:
            behind, ahead = int(parts[0]), int(parts[1])
    last_commit_relative = _git(cwd, "log", "-1", "--format=%cr") or "no commits"
    return {
        "root": root,
        "branch": branch,
        "dirty": dirty,
        "ahead": ahead,
        "behind": behind,
        "last_commit_relative": last_commit_relative,
    }


def build_windows_payload(
    rows: list[dict], git_cache: dict[str, dict | None], boot_epoch_s: float, now_epoch_s: float
) -> list[dict]:
    windows = []
    for row in rows:
        windows.append(
            {
                **row,
                "idle_label": idle_label(
                    row["last_focused_at"], row["is_focused"], boot_epoch_s, now_epoch_s
                ),
                "git": git_cache.get(row["cwd"]),
                # Only trust a pid's session file when that pid is *currently* running
                # claude (kitty's own live process data) - a pid whose claude session
                # ended and got reused by an unrelated process must not show a stale title.
                "claude_session": claude_session_name(row.get("pid")) if row.get("proc") == "claude" else None,
            }
        )
    return windows


# ── deterministic tab grouping (no AI) ──────────────────────────────────────


def project_key(window: dict) -> str:
    git = window.get("git")
    if git and git.get("root"):
        return git["root"]
    return window["cwd"]


def project_label(window: dict) -> str:
    return Path(project_key(window)).name


def plan_moves(windows: list[dict]) -> dict[int, int]:
    """Return {window_id: target_tab_id} for windows not on their project's home tab."""
    by_project: dict[str, list[dict]] = {}
    for w in windows:
        by_project.setdefault(project_key(w), []).append(w)

    moves: dict[int, int] = {}
    for members in by_project.values():
        tab_ids = {w["tab_id"] for w in members}
        if len(tab_ids) <= 1:
            continue  # already on one tab, nothing to consolidate
        counts = Counter(w["tab_id"] for w in members)
        max_count = max(counts.values())
        home_tab = min(tab for tab, count in counts.items() if count == max_count)
        for w in members:
            if w["tab_id"] != home_tab:
                moves[w["id"]] = home_tab
    return moves


# ── Claude call (close/keep only) ───────────────────────────────────────────

OUTPUT_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["recommendations"],
    "properties": {
        "recommendations": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": ["id", "action", "reason"],
                "properties": {
                    "id": {"type": "integer", "description": "The window id from the input."},
                    "action": {"type": "string", "enum": ["close", "keep"]},
                    "reason": {"type": "string"},
                },
            },
        }
    },
}

SYSTEM_PROMPT = """
You are an expert at tidying up a developer's terminal windows.
You will be given a JSON array of open terminal windows, each tied to a project directory.
For each window, decide whether it is safe to "close" (stale and safe to discard) or should be kept ("keep").
Judge staleness from: idle time, whether the git working tree is dirty or clean, commits ahead/behind
the upstream branch, how long ago the last commit was, and whether this window is a redundant duplicate
of another window already open on the same project. A window's claude_session field, if present, names
the Claude Code session running there - a distinctive name (not a generic default) suggests active,
purposeful work and is a reason to lean toward "keep".
The is_focused field (reflected as "active in tab" in the idle field) means this window was the
last-active window within its own tab - it does NOT mean the user is looking at it right now (kitty
tracks that per tab, and several tabs can each show is_focused independently). Treat it as a weak
signal only, not a strong reason to keep.
Never recommend "close" for a window whose cmdline suggests a long-running server, watcher, or daemon
process (e.g. contains "serve", "watch", "--watch", "dev", "listen", "daemon", "tail -f", "mcp serve")
- closing it would kill that process.
Prefer "keep" when uncertain or when the window has a dirty git tree.
Return only the structured JSON described by the schema — no commentary.
""".strip()

PROMPT_TEMPLATE = """
Review the following open windows and recommend close or keep for each.
<windows>
{json}
</windows>
""".strip()


def _window_for_prompt(w: dict) -> dict:
    git = w.get("git")
    return {
        "id": w["id"],
        "project": project_label(w),
        "cwd": w["cwd"],
        "cmdline": w.get("cmdline"),
        "is_focused": w["is_focused"],
        "idle": w["idle_label"],
        "git": git,
        "claude_session": w.get("claude_session"),
    }


def build_prompt(windows: list[dict]) -> str:
    payload = [_window_for_prompt(w) for w in windows]
    return PROMPT_TEMPLATE.format(json=json.dumps(payload, ensure_ascii=False))


def advise(windows: list[dict], model: str, client: "anthropic.Anthropic") -> dict:
    prompt = build_prompt(windows)
    response = client.messages.create(
        system=SYSTEM_PROMPT,
        model=model,
        max_tokens=2048,
        messages=[{"role": "user", "content": prompt}],
        output_config={"format": {"type": "json_schema", "schema": OUTPUT_SCHEMA}},
    )
    text = next(b.text for b in response.content if b.type == "text")
    return json.loads(text)


# ── combining ────────────────────────────────────────────────────────────────


def merge_actions(windows: list[dict], recommendations: dict, moves: dict[int, int]) -> list[dict]:
    by_id = {r["id"]: r for r in recommendations.get("recommendations", [])} if recommendations else {}

    final = []
    for w in windows:
        rec = by_id.get(w["id"])
        if rec and rec.get("action") == "close":
            action, target_tab, reason = "close", None, rec.get("reason", "")
        elif w["id"] in moves:
            action, target_tab = "move", moves[w["id"]]
            reason = f"consolidate onto {project_label(w)} tab"
        elif rec and rec.get("action") == "keep":
            action, target_tab, reason = "keep", None, rec.get("reason", "")
        else:
            action, target_tab, reason = "keep", None, NO_RECOMMENDATION
        label = f"{project_label(w)} > {Path(w['cwd']).name} ({w['idle_label']})"
        if w.get("claude_session"):
            label += f" [{w['claude_session']}]"
        final.append(
            {
                "id": w["id"],
                "action": action,
                "target_tab": target_tab,
                "reason": reason,
                "label": label,
            }
        )
    return final


CURRENT_WINDOW_REASON = "current window — never auto-closed/moved"
CURRENT_WINDOW_MARKER = "· YOU ARE HERE"


def protect_current_window(final_rows: list[dict], current_window_id: int | None) -> list[dict]:
    """Hard-override the row for `current_window_id` to "keep", regardless of the model's
    recommendation or a planned move.

    `is_focused` in `kitty @ ls` is per-tab, not "the window the user is using right now" -
    the real current window (the one under this overlay) actually reads is_focused=False, so
    it can't be identified from the model's input alone. The caller (bin/tidy-windows) finds
    it independently via `state:overlay_parent` and passes it here as ground truth. Enforced
    in code rather than left to the model's judgement, since this one must never be wrong.
    """
    if current_window_id is None:
        return final_rows
    for r in final_rows:
        if r["id"] == current_window_id:
            r["action"] = "keep"
            r["target_tab"] = None
            r["reason"] = CURRENT_WINDOW_REASON
            if CURRENT_WINDOW_MARKER not in r["label"]:
                r["label"] = f"{r['label']} {CURRENT_WINDOW_MARKER}"
    return final_rows


_ACTION_ORDER = {"close": 0, "move": 0, "keep": 1}


def _sorted_rows(final_rows: list[dict]) -> list[dict]:
    return sorted(final_rows, key=lambda r: (_ACTION_ORDER.get(r["action"], 2), r["label"]))


def to_fzf_tsv(final_rows: list[dict]) -> str:
    """TSV for the interactive picker - "keep" rows are a no-op there (selecting one and
    applying does nothing), so they're excluded; use --dry-run to see the full picture
    including keeps and why."""
    lines = []
    for r in _sorted_rows(final_rows):
        if r["action"] == "keep":
            continue
        tag = "[CLOSE]" if r["action"] == "close" else f"[MOVE→tab {r['target_tab']}]"
        display = f"{tag} {r['label']} — {r['reason']}"
        lines.append(f"{r['id']}\t{r['action']}\t{r['target_tab'] or ''}\t{display}")
    return "\n".join(lines)


def render_dry_run(final_rows: list[dict]) -> str:
    lines = []
    for r in _sorted_rows(final_rows):
        lines.append(f"{r['action']:5s} {r['label']:40s} {r['reason']}")
    return "\n".join(lines)


# ── main ─────────────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(description="Recommend close/move/keep for open kitty windows.")
    parser.add_argument("--kitty-ls", help="Path to `kitty @ ls` JSON (default: read stdin)")
    parser.add_argument("--model", default=DEFAULT_MODEL, help="Anthropic model to use")
    parser.add_argument("--dry-run", action="store_true", help="Print a human-readable table instead of TSV")
    parser.add_argument(
        "--current-window-id", type=int, default=None,
        help="The real current window's id (e.g. the overlay's parent), always kept",
    )
    args = parser.parse_args()

    raw = Path(args.kitty_ls).read_text(encoding="utf-8") if args.kitty_ls else sys.stdin.read()
    kitty_ls_json = json.loads(raw)

    rows = build_rows(kitty_ls_json)
    if not rows:
        print("tidy-windows: no open windows to review", file=sys.stderr)
        return

    print("tidy-windows: checking window/git state…", file=sys.stderr)
    unique_cwds = {r["cwd"] for r in rows}
    git_cache = {cwd: git_summary(cwd) for cwd in unique_cwds}

    boot_epoch_s = boot_epoch()
    now_epoch_s = time.time()
    windows = build_windows_payload(rows, git_cache, boot_epoch_s, now_epoch_s)
    moves = plan_moves(windows)

    try:
        client = anthropic.Anthropic()
        print("tidy-windows: asking Claude for recommendations…", file=sys.stderr)
        recommendations = advise(windows, args.model, client)
    except Exception as exc:  # noqa: BLE001 - degrade gracefully, never crash the whole run
        print(f"tidy-windows: advice unavailable ({exc}); falling back to keep-only", file=sys.stderr)
        recommendations = {}

    final_rows = merge_actions(windows, recommendations, moves)
    final_rows = protect_current_window(final_rows, args.current_window_id)

    if args.dry_run:
        print(render_dry_run(final_rows))
        return

    tsv = to_fzf_tsv(final_rows)
    if not tsv:
        print(
            f"tidy-windows: {len(final_rows)} window(s) reviewed — nothing to close or move",
            file=sys.stderr,
        )
        return
    print(tsv)


if __name__ == "__main__":
    main()
