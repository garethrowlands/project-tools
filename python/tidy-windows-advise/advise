#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["anthropic>=0.40"]
# ///
"""Review open kitty windows and recommend close / move / keep.

Reads `kitty @ ls` JSON (via --kitty-ls or stdin) and prints a TSV table
(`id  action  target_tab  display`) for the caller (zsh/bin/tidy-windows) to feed
into fzf and act on. --dry-run prints a human-readable table instead.

Close-vs-keep is judged by the Claude API (idle time, git state). Move
recommendations (consolidating a project's windows onto one tab) are computed
deterministically in Python — no AI call needed for that part.
"""

import argparse
import json
import subprocess
import sys
import time
from collections import Counter
from pathlib import Path

import anthropic

DEFAULT_MODEL = "claude-haiku-4-5-20251001"
NO_RECOMMENDATION = "(no recommendation available)"

# ── kitty ls parsing ─────────────────────────────────────────────────────────


def _cmdline_basename(cmdline: list | None) -> str:
    """The frontmost command's basename, e.g. "-/opt/homebrew/bin/claude" -> "claude"."""
    if not cmdline:
        return ""
    first = cmdline[0] or ""
    if first.startswith("-"):
        first = first[1:]
    return Path(first).name


SHELLS = {"zsh", "bash", "fish", "sh", "dash", "ksh", "tcsh", "nu", "xonsh"}
# A picker left open (bin/window, sw, the project picker: fzf under a zsh script) holds
# nothing but its list, so it doesn't count as running anything - a stale one can be closed.
PICKERS = {"fzf"}


def running_commands(foreground_processes: list) -> list[str]:
    """Basenames of what a window is running besides a shell prompt, e.g. ["node", "esbuild"]
    for a dev server - closing the window would kill them. Empty for a window sitting at its
    shell or showing a forgotten fzf picker, and for one running `claude`: its child
    processes (MCP servers, caffeinate) come and go with the session, whose own agent state
    decides whether it is safe to close."""
    names = [_cmdline_basename(p.get("cmdline")) for p in foreground_processes]
    if "claude" in names:
        return []
    return list(dict.fromkeys(n for n in names if n and n not in SHELLS | PICKERS))


def build_rows(kitty_ls_json: list) -> list[dict]:
    """Flatten `kitty @ ls` JSON into one row per real (non-self) window with a cwd."""
    rows = []
    for os_window in kitty_ls_json:
        for tab in os_window.get("tabs", []):
            # A tab's groups each hold a base window and the overlays on it. kitty doesn't
            # list them base-first, but an overlay is always created after the window it
            # covers and ids only go up, so the base is the lowest id in its group.
            overlay_ids = {
                wid
                for group in tab.get("groups") or []
                for wid in sorted(group.get("windows") or [])[1:]
            }
            for window in tab.get("windows", []):
                if window.get("is_self"):
                    continue
                fg = window.get("foreground_processes") or [{}]
                cwd = fg[0].get("cwd")
                if not cwd:
                    continue
                rows.append(
                    {
                        "id": window["id"],
                        "tab_id": tab.get("id"),
                        "tab_title": tab.get("title", ""),
                        "title": window.get("title", ""),
                        "cwd": cwd,
                        "cmdline": fg[0].get("cmdline", []),
                        # every foreground process, not just the first: a dev server's
                        # first is often a helper (esbuild), not the server itself
                        "processes": [" ".join(p.get("cmdline") or []) for p in fg],
                        "running": running_commands(fg),
                        "is_overlay": window["id"] in overlay_ids,
                        "is_focused": bool(window.get("is_focused")),
                        "last_focused_at": window.get("last_focused_at"),
                        # when you last looked at the window, stamped by kitty/focus_watcher.py
                        "seen_at": (window.get("user_vars") or {}).get("seen_at"),
                        # last foreground process is the front-most running command
                        # (e.g. `claude`) - used to look up a Claude session name below.
                        "pid": fg[-1].get("pid"),
                        "proc": _cmdline_basename(fg[-1].get("cmdline")),
                    }
                )
    return rows


# ── Claude session titles ────────────────────────────────────────────────────
#
# See zsh/bin/window-list's _window_list_claude_title for the full rationale (this
# mirrors it): <config-dir>/sessions/<pid>.json's "name" field is NOT the conversation
# title shown in Claude Code's own UI/history - it's a short slug derived at startup,
# used as an addressable session name elsewhere. The actual human-facing title is
# recorded as a `{"type":"ai-title","aiTitle":"..."}` line appended to that session's
# own transcript, at <config-dir>/projects/*/<sessionId>.jsonl - found by sessionId
# rather than by reconstructing the project-slug directory name from cwd, since that
# slug transform is lossy (e.g. "." becomes "-" too, not just "/"). An interactive
# session can also "park" on a background job (a separate claude process, with its own
# pid/session file, "kind":"bg") via "parkedJobId" matching the job's own "jobId"; while
# parked, the interactive session's own transcript typically has no ai-title yet, so the
# lookup follows parkedJobId to the job's session file and resolves its title the same
# way. And a `claude` process may run under a non-default config dir (e.g.
# CLAUDE_CONFIG_DIR=~/.claude-k for a separate work profile), so every ~/.claude*
# directory with a sessions/ subfolder is searched, not just ~/.claude.
#
# All of this is undocumented internal state, so failures here should never be fatal.


def _config_dirs(home: Path | None = None) -> list[Path]:
    home = home or Path.home()
    return sorted(p for p in home.glob(".claude*") if (p / "sessions").is_dir())


def _read_json(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def _find_transcript(config_dir: Path, session_id: str) -> Path | None:
    matches = list((config_dir / "projects").glob(f"*/{session_id}.jsonl"))
    return matches[0] if matches else None


def _last_ai_title(transcript: Path) -> str | None:
    title = None
    try:
        with transcript.open(encoding="utf-8") as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if entry.get("type") == "ai-title" and isinstance(entry.get("aiTitle"), str) and entry["aiTitle"]:
                    title = entry["aiTitle"]
    except OSError:
        return None
    return title


def _title_from_session_file(config_dir: Path, session_file: Path) -> str | None:
    """The best available title recorded in one sessions/<pid>.json: its own ai-title,
    else (if parked on a background job) that job's title by the same rule, else its
    own "name" slug."""
    data = _read_json(session_file)
    if data is None:
        return None
    session_id = data.get("sessionId")
    if isinstance(session_id, str) and session_id:
        transcript = _find_transcript(config_dir, session_id)
        if transcript is not None:
            title = _last_ai_title(transcript)
            if title:
                return title
    parked_job_id = data.get("parkedJobId")
    if isinstance(parked_job_id, str) and parked_job_id:
        for job_file in (config_dir / "sessions").glob("*.json"):
            if job_file == session_file:
                continue
            job_data = _read_json(job_file)
            if job_data and job_data.get("jobId") == parked_job_id:
                job_title = _title_from_session_file(config_dir, job_file)
                if job_title:
                    return job_title
                break
    name = data.get("name")
    return name if isinstance(name, str) and name else None


def _session_file(pid, config_dirs: list[Path] | None = None) -> tuple[Path, Path] | None:
    """(config dir, session file) of a claude process's pid. Should two config dirs have
    one for this pid (one left by a dead process whose pid has been reused), the most
    recently modified is the live process's."""
    if not pid:
        return None
    found = []
    for config_dir in config_dirs if config_dirs is not None else _config_dirs():
        session_file = config_dir / "sessions" / f"{pid}.json"
        if session_file.is_file():
            found.append((config_dir, session_file))
    return max(found, key=lambda f: f[1].stat().st_mtime) if found else None


def claude_session_name(pid, config_dirs: list[Path] | None = None) -> str | None:
    """Look up a running Claude Code session's title by its pid."""
    found = _session_file(pid, config_dirs)
    return _title_from_session_file(*found) if found else None


# ── Claude agent state ───────────────────────────────────────────────────────
#
# What the agent in a window is doing, by the same rules as `_claude_session_state` in
# zsh/functions/claude-session.zsh (the window picker, next-agent) and `agent_state` in
# kitty/focus_watcher.py (tab markers, notifications) - keep the three in step. From the
# session file's "status" and "statusUpdatedAt" (ms epoch of the last status change):
#
#   blocked  "waiting": on you, for a permission or an answer
#   working  "busy"
#   done     "idle" or "shell", since after you last looked at the window (its `seen_at`)
#   idle     "idle" or "shell", and you've seen it
#
# The window you are in right now is never "done": you are looking at it.


def agent_state(status, since_s: float, seen_at, looked_at: bool) -> str | None:
    if status == "waiting":
        return "blocked"
    if status == "busy":
        return "working"
    if status in ("idle", "shell"):
        if str(seen_at or "").isdigit() and not looked_at and since_s > int(seen_at):
            return "done"
        return "idle"
    return None


def claude_agent_state(pid, seen_at, looked_at: bool, config_dirs: list[Path] | None = None) -> str | None:
    """A running Claude Code session's agent state by its pid, None if it can't be told."""
    found = _session_file(pid, config_dirs)
    data = _read_json(found[1]) if found else None
    if not data:
        return None
    try:
        since_s = float(data.get("statusUpdatedAt") or 0) / 1000
    except (TypeError, ValueError):
        return None
    return agent_state(data.get("status"), since_s, seen_at, looked_at)


# ── idle time ────────────────────────────────────────────────────────────────


# How long since you last looked at a window. Two sources, best first:
#
# - the window's `seen_at` user var: wall-clock seconds, stamped by kitty/focus_watcher.py
#   whenever the window gains or loses focus. Exact, but only on windows the watcher has seen.
# - kitty's own `last_focused_at`. That is on kitty's monotonic clock, which has no fixed
#   relation to wall-clock time (on macOS it stops while the machine sleeps, so "boot time
#   plus last_focused_at" can be days out). It can only be compared with another reading of
#   the same clock, and `kitty @ ls` doesn't give the current one - so the newest
#   last_focused_at of any window stands in for "now". That is when you entered the window
#   you ran this from (just now, for the overlay tidy-windows is normally launched in), so
#   it can only understate an idle time, by however long you had been in that window.


def kitty_now(kitty_ls_json: list) -> float | None:
    """The newest `last_focused_at` of any window (the overlay itself included)."""
    stamps = [
        float(window["last_focused_at"])
        for os_window in kitty_ls_json
        for tab in os_window.get("tabs", [])
        for window in tab.get("windows", [])
        if isinstance(window.get("last_focused_at"), (int, float))
    ]
    return max(stamps) if stamps else None


def idle_seconds(last_focused_at, seen_at, kitty_now_s: float | None, now_epoch_s: float) -> float | None:
    if str(seen_at or "").isdigit():
        return max(now_epoch_s - int(seen_at), 0)
    if last_focused_at is None or kitty_now_s is None:
        return None
    return max(kitty_now_s - float(last_focused_at), 0)


def idle_label(idle_s: float | None, is_focused: bool) -> str:
    if is_focused:
        # NOT "the window the user is using right now" - kitty's is_focused is per-tab (the
        # last-active window *within that tab*), so several unrelated windows can show this
        # simultaneously. Worded to avoid being mistaken for protect_current_window's
        # unambiguous "YOU ARE HERE" marker, which is the real current-window signal.
        return "active in tab"
    if idle_s is None:
        return "idle"
    minutes = idle_s / 60
    if minutes < 60:
        return f"{max(1, round(minutes))}m idle"
    hours = minutes / 60
    if hours < 24:
        return f"{round(hours)}h idle"
    days = hours / 24
    return f"{round(days)}d idle"


# ── git enrichment ───────────────────────────────────────────────────────────


def _git(cwd: str, *args: str) -> str | None:
    result = subprocess.run(
        ["git", "-C", cwd, *args], capture_output=True, text=True
    )
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def git_summary(cwd: str) -> dict | None:
    root = _git(cwd, "rev-parse", "--show-toplevel")
    if root is None:
        return None
    branch = _git(cwd, "branch", "--show-current") or "(detached)"
    status = _git(cwd, "status", "--porcelain") or ""
    dirty = bool(status.strip())
    ahead = 0
    behind = 0
    counts = _git(cwd, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
    if counts:
        parts = counts.split()
        if len(parts) == 2:
            behind, ahead = int(parts[0]), int(parts[1])
    last_commit_relative = _git(cwd, "log", "-1", "--format=%cr") or "no commits"
    # A linked worktree is a branch of its repo checked out elsewhere, not a project of
    # its own: its project is the main worktree, the folder holding the shared .git dir.
    common_dir = _git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    project_root = str(Path(common_dir).parent) if common_dir and Path(common_dir).name == ".git" else root
    return {
        "root": root,
        "project_root": project_root,
        "branch": branch,
        "dirty": dirty,
        "ahead": ahead,
        "behind": behind,
        "last_commit_relative": last_commit_relative,
    }


def build_windows_payload(
    rows: list[dict],
    git_cache: dict[str, dict | None],
    kitty_now_s: float | None,
    now_epoch_s: float,
    current_window_id: int | None = None,
) -> list[dict]:
    windows = []
    for row in rows:
        is_claude = row.get("proc") == "claude"
        windows.append(
            {
                **row,
                "idle_label": idle_label(
                    idle_seconds(row["last_focused_at"], row.get("seen_at"), kitty_now_s, now_epoch_s),
                    row["is_focused"],
                ),
                "git": git_cache.get(row["cwd"]),
                # Only trust a pid's session file when that pid is *currently* running
                # claude (kitty's own live process data) - a pid whose claude session
                # ended and got reused by an unrelated process must not show a stale title.
                "claude_session": claude_session_name(row.get("pid")) if is_claude else None,
                "claude_state": (
                    claude_agent_state(row.get("pid"), row.get("seen_at"), row["id"] == current_window_id)
                    if is_claude
                    else None
                ),
            }
        )
    return windows


# ── deterministic tab grouping (no AI) ──────────────────────────────────────


def project_key(window: dict) -> str:
    git = window.get("git")
    if git and (git.get("project_root") or git.get("root")):
        return git.get("project_root") or git["root"]
    return window["cwd"]


def project_label(window: dict) -> str:
    return Path(project_key(window)).name


def tab_name(title: str) -> str:
    """A tab's name for matching against projects: the last component of its title.

    A tab made by switch-project is titled with the bare project name; one with no
    explicit title shows its window's title, a path relative to the project roots.
    """
    return title.rstrip("/").rsplit("/", 1)[-1]


def plan_moves(windows: list[dict]) -> dict[int, int | str]:
    """Return {window_id: target} for windows not on their project's tab.

    One tab per project. A project's home is a tab it owns: one titled with its name,
    or else one where it has more windows than any other project. Of several, a titled
    one, then the one with most of its windows (lowest id on a tie). A window elsewhere moves to the home,
    as a tab id. A window sitting in a tab another project owns, when its own project
    has no home, goes to `"new:<project>"`: one new tab per project, which the caller
    creates and titles. A tab nobody owns is left alone.
    """
    labels = {project_label(w) for w in windows}
    by_tab: dict[int, list[dict]] = {}
    for w in windows:
        by_tab.setdefault(w["tab_id"], []).append(w)

    def owner(tab_id: int) -> str | None:
        members = by_tab[tab_id]
        title = tab_name(members[0].get("tab_title") or "")
        if title in labels:
            return title
        counts = Counter(project_label(w) for w in members).most_common(2)
        if len(counts) == 1 or counts[0][1] > counts[1][1]:
            return counts[0][0]
        return None

    owners = {tab_id: owner(tab_id) for tab_id in by_tab}

    moves: dict[int, int | str] = {}
    for label in sorted(labels):
        members = [w for w in windows if project_label(w) == label]
        counts = Counter(w["tab_id"] for w in members if owners[w["tab_id"]] == label)
        titled = lambda tab: tab_name(by_tab[tab][0].get("tab_title") or "") == label  # noqa: E731
        home = min(counts, key=lambda tab: (not titled(tab), -counts[tab], tab)) if counts else None
        for w in members:
            tab_owner = owners[w["tab_id"]]
            if home is not None:
                if w["tab_id"] != home:
                    moves[w["id"]] = home
            elif tab_owner not in (None, label):
                moves[w["id"]] = f"new:{label}"
    return moves


# ── Claude call (close/keep only) ───────────────────────────────────────────

OUTPUT_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["recommendations"],
    "properties": {
        "recommendations": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": ["id", "action", "reason"],
                "properties": {
                    "id": {"type": "integer", "description": "The window id from the input."},
                    "action": {"type": "string", "enum": ["close", "keep"]},
                    "reason": {"type": "string"},
                },
            },
        }
    },
}

SYSTEM_PROMPT = """
You are an expert at tidying up a developer's terminal windows.
You will be given a JSON array of open terminal windows, each tied to a project directory.
For each window, decide whether it is safe to "close" (stale and safe to discard) or should be kept ("keep").
Judge staleness from: idle time, whether the git working tree is dirty or clean, commits ahead/behind
the upstream branch, how long ago the last commit was, and whether this window is a redundant duplicate
of another window already open on the same project - which only ever applies to shell windows. Two windows
running claude in the same directory, on the same branch, are two different conversations, never duplicates,
whatever their git state; the same goes for any two windows running different commands. A window's claude_session field, if present, names
the Claude Code session running there - a distinctive name (not a generic default) suggests active,
purposeful work and is a reason to lean toward "keep". A window whose processes are just fzf under a
shell script is a picker someone left open; once it has been idle a while it is safe to close. Its claude_state field says what that session
is doing: "working" (mid-task), "blocked" (waiting on the user for a permission or an answer), "done"
(finished, and the user has not looked at the result yet) or "idle" (finished, and the user has seen
it). Never recommend "close" for a window running a Claude session, whatever its state.
The is_focused field (reflected as "active in tab" in the idle field) means this window was the
last-active window within its own tab - it does NOT mean the user is looking at it right now (kitty
tracks that per tab, and several tabs can each show is_focused independently). Treat it as a weak
signal only, not a strong reason to keep.
The processes field lists the command line of every foreground process in the window. Never recommend
"close" for a window where any of them suggests a long-running server, watcher, or daemon process (e.g.
contains "serve", "watch", "--watch", "dev", "listen", "daemon", "tail -f", "mcp serve") - closing it
would kill that process.
Prefer "keep" when uncertain or when the window has a dirty git tree.
Return only the structured JSON described by the schema — no commentary.
""".strip()

PROMPT_TEMPLATE = """
Review the following open windows and recommend close or keep for each.
<windows>
{json}
</windows>
""".strip()


def _window_for_prompt(w: dict) -> dict:
    git = w.get("git")
    return {
        "id": w["id"],
        "project": project_label(w),
        "cwd": w["cwd"],
        "cmdline": w.get("cmdline"),
        "processes": w.get("processes"),
        "is_focused": w["is_focused"],
        "idle": w["idle_label"],
        "git": git,
        "claude_session": w.get("claude_session"),
        "claude_state": w.get("claude_state"),
    }


def build_prompt(windows: list[dict]) -> str:
    payload = [_window_for_prompt(w) for w in windows]
    return PROMPT_TEMPLATE.format(json=json.dumps(payload, ensure_ascii=False))


def advise(windows: list[dict], model: str, client: "anthropic.Anthropic") -> dict:
    prompt = build_prompt(windows)
    response = client.messages.create(
        system=SYSTEM_PROMPT,
        model=model,
        max_tokens=2048,
        messages=[{"role": "user", "content": prompt}],
        output_config={"format": {"type": "json_schema", "schema": OUTPUT_SCHEMA}},
    )
    text = next(b.text for b in response.content if b.type == "text")
    return json.loads(text)


# ── combining ────────────────────────────────────────────────────────────────


# An overlay other than the one tidy-windows itself runs in (is_self, never listed) is one
# you walked away from - a picker, a pager - since you can only be in one place. Closing it
# just reveals the window underneath, so it is always recommended, without asking the model.
# (An overlay running an active Claude agent is still kept: see protect_active_agents.)
OVERLAY_REASON = "overlay left open — closing it reveals the window underneath"

# the window picker's markers, for the states that need you to know about them
AGENT_MARKERS = {"blocked": "!", "done": "✓", "working": "…"}


def move_reason(window: dict, target) -> str:
    if isinstance(target, str):
        return f"move to a new {project_label(window)} tab"
    return f"consolidate onto {project_label(window)} tab"


def _decline_close(row: dict, reason: str) -> None:
    """Turn a "close" into a "keep" for `reason` - or into the move the window was due,
    since not closing it leaves it in the wrong tab."""
    if row.get("planned_move"):
        row["action"] = "move"
        row["target_tab"], row["reason"] = row["planned_move"]
    else:
        row["action"] = "keep"
        row["reason"] = reason


def merge_actions(windows: list[dict], recommendations: dict, moves: dict[int, int]) -> list[dict]:
    by_id = {r["id"]: r for r in recommendations.get("recommendations", [])} if recommendations else {}

    final = []
    for w in windows:
        rec = by_id.get(w["id"])
        if w.get("is_overlay"):
            action, target_tab, reason = "close", None, OVERLAY_REASON
        elif rec and rec.get("action") == "close":
            action, target_tab, reason = "close", None, rec.get("reason", "")
        elif w["id"] in moves:
            action, target_tab = "move", moves[w["id"]]
            reason = move_reason(w, target_tab)
        elif rec and rec.get("action") == "keep":
            action, target_tab, reason = "keep", None, rec.get("reason", "")
        else:
            action, target_tab, reason = "keep", None, NO_RECOMMENDATION
        label = f"{project_label(w)} > {Path(w['cwd']).name} ({w['idle_label']})"
        if w.get("is_overlay"):
            label += " (overlay)"
        if w.get("running"):
            label += f" ({', '.join(w['running'])})"
        if w.get("claude_state") in AGENT_MARKERS:
            label += f" {AGENT_MARKERS[w['claude_state']]}"
        if w.get("claude_session"):
            label += f" [{w['claude_session']}]"
        final.append(
            {
                "id": w["id"],
                "claude_state": w.get("claude_state"),
                "running": w.get("running") or [],
                "is_overlay": bool(w.get("is_overlay")),
                "action": action,
                "target_tab": target_tab,
                "reason": reason,
                "label": label,
                # kept for the protections below, which turn a "close" into a "keep":
                # the window still belongs on its project's tab
                "planned_move": (moves[w["id"]], move_reason(w, moves[w["id"]])) if w["id"] in moves else None,
            }
        )
    return final


CURRENT_WINDOW_REASON = "current window — never auto-closed/moved"
CURRENT_WINDOW_MARKER = "· YOU ARE HERE"


def protect_current_window(final_rows: list[dict], current_window_id: int | None) -> list[dict]:
    """Hard-override the row for `current_window_id` to "keep", regardless of the model's
    recommendation or a planned move.

    `is_focused` in `kitty @ ls` is per-tab, not "the window the user is using right now" -
    the real current window (the one under this overlay) actually reads is_focused=False, so
    it can't be identified from the model's input alone. The caller (bin/tidy-windows) finds
    it independently via `state:overlay_parent` and passes it here as ground truth. Enforced
    in code rather than left to the model's judgement, since this one must never be wrong.
    """
    if current_window_id is None:
        return final_rows
    for r in final_rows:
        if r["id"] == current_window_id:
            r["action"] = "keep"
            r["target_tab"] = None
            r["reason"] = CURRENT_WINDOW_REASON
            if CURRENT_WINDOW_MARKER not in r["label"]:
                r["label"] = f"{r['label']} {CURRENT_WINDOW_MARKER}"
    return final_rows


ACTIVE_AGENT_REASONS = {
    "working": "Claude is working here — never auto-closed",
    "blocked": "Claude is waiting on you here — never auto-closed",
    "done": "Claude finished here and you haven't looked yet — never auto-closed",
    "idle": "a Claude session lives here — never auto-closed",
}


def protect_active_agents(final_rows: list[dict]) -> list[dict]:
    """Hard-override "close" to "keep" for any window running a Claude agent: working,
    blocked on you or unread, closing it would kill the task or throw away an answer; even
    an idle one is a conversation of its own, which nothing here can tell is finished with. Enforced in code, like the current
    window, rather than left to the model. A move is harmless (the session carries on in
    its new tab), so moves stand."""
    for r in final_rows:
        if r["action"] == "close" and r.get("claude_state") in ACTIVE_AGENT_REASONS:
            _decline_close(r, ACTIVE_AGENT_REASONS[r["claude_state"]])
    return final_rows


def protect_running_processes(final_rows: list[dict]) -> list[dict]:
    """Hard-override "close" to "keep" for a window that is running something other than a
    shell prompt (see `running_commands`): closing it would kill that process, and whether
    a dev server or watcher is still wanted isn't something to guess from its command
    line. An abandoned overlay is the exception (see OVERLAY_REASON). Enforced in code - the model, asked not to close such windows, has done so
    anyway. Moves stand: the process carries on in its new tab."""
    for r in final_rows:
        if r["action"] == "close" and r.get("running") and not r.get("is_overlay"):
            _decline_close(r, f"running {', '.join(r['running'])} — never auto-closed (closing would kill it)")
    return final_rows


_ACTION_ORDER = {"close": 0, "move": 0, "keep": 1}


def _sorted_rows(final_rows: list[dict]) -> list[dict]:
    return sorted(final_rows, key=lambda r: (_ACTION_ORDER.get(r["action"], 2), r["label"]))


def to_fzf_tsv(final_rows: list[dict]) -> str:
    """TSV for the interactive picker - "keep" rows are a no-op there (selecting one and
    applying does nothing), so they're excluded; use --dry-run to see the full picture
    including keeps and why."""
    lines = []
    for r in _sorted_rows(final_rows):
        if r["action"] == "keep":
            continue
        if r["action"] == "close":
            tag = "[CLOSE]"
        elif isinstance(r["target_tab"], str):
            tag = f"[MOVE→new {r['target_tab'].removeprefix('new:')} tab]"
        else:
            tag = f"[MOVE→tab {r['target_tab']}]"
        display = f"{tag} {r['label']} — {r['reason']}"
        lines.append(f"{r['id']}\t{r['action']}\t{r['target_tab'] or ''}\t{display}")
    return "\n".join(lines)


def render_dry_run(final_rows: list[dict]) -> str:
    lines = []
    for r in _sorted_rows(final_rows):
        lines.append(f"{r['action']:5s} {r['label']:40s} {r['reason']}")
    return "\n".join(lines)


# ── main ─────────────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(description="Recommend close/move/keep for open kitty windows.")
    parser.add_argument("--kitty-ls", help="Path to `kitty @ ls` JSON (default: read stdin)")
    parser.add_argument("--model", default=DEFAULT_MODEL, help="Anthropic model to use")
    parser.add_argument("--dry-run", action="store_true", help="Print a human-readable table instead of TSV")
    parser.add_argument(
        "--current-window-id", type=int, default=None,
        help="The real current window's id (e.g. the overlay's parent), always kept",
    )
    args = parser.parse_args()

    raw = Path(args.kitty_ls).read_text(encoding="utf-8") if args.kitty_ls else sys.stdin.read()
    kitty_ls_json = json.loads(raw)

    rows = build_rows(kitty_ls_json)
    if not rows:
        print("tidy-windows: no open windows to review", file=sys.stderr)
        return

    print("tidy-windows: checking window/git state…", file=sys.stderr)
    unique_cwds = {r["cwd"] for r in rows}
    git_cache = {cwd: git_summary(cwd) for cwd in unique_cwds}

    kitty_now_s = kitty_now(kitty_ls_json)
    now_epoch_s = time.time()
    windows = build_windows_payload(rows, git_cache, kitty_now_s, now_epoch_s, args.current_window_id)
    moves = plan_moves(windows)

    try:
        client = anthropic.Anthropic()
        print("tidy-windows: asking Claude for recommendations…", file=sys.stderr)
        recommendations = advise(windows, args.model, client)
    except Exception as exc:  # noqa: BLE001 - degrade gracefully, never crash the whole run
        print(f"tidy-windows: advice unavailable ({exc}); falling back to keep-only", file=sys.stderr)
        recommendations = {}

    final_rows = merge_actions(windows, recommendations, moves)
    final_rows = protect_active_agents(final_rows)
    final_rows = protect_running_processes(final_rows)
    final_rows = protect_current_window(final_rows, args.current_window_id)

    if args.dry_run:
        print(render_dry_run(final_rows))
        return

    tsv = to_fzf_tsv(final_rows)
    if not tsv:
        print(
            f"tidy-windows: {len(final_rows)} window(s) reviewed — nothing to close or move",
            file=sys.stderr,
        )
        return
    print(tsv)


if __name__ == "__main__":
    main()
